{%
	import { getuid, getspnam } from 'luci.core';
	import * as fs from 'fs';
	const boardinfo = ubus.call('system', 'board');
	const ark_v = trim(fs.readfile('/usr/share/ark-router/VERSION') ?? '1.5.2');
	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? 'ARK Router'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" content="#0f172a">
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ ark_v }}">
		<link rel="stylesheet" media="only screen and (max-width: 854px)" href="{{ media }}/mobile.css?v={{ ark_v }}" />
		<link rel="icon" href="{{ media }}/favicon.png">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js?v={{ ark_v }}"></script>
		<script src="{{ media }}/ark-theme.js?v={{ ark_v }}"></script>
		<script>window.ARK_VERSION = "{{ ark_v }}";</script>
	</head>
	{% let is_login = !(ctx?.authsession || dispatcher?.context?.authsession); %}
	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }} {{ is_login ? 'ark-login-page' : 'ark-app-page' }} ark-theme" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		{% if (!is_login): %}
		<div class="ark-mobile-bar">
			<button type="button" class="ark-menu-toggle" id="ark-menu-toggle" aria-label="Menu">
				<span class="ark-burger-line"></span>
				<span class="ark-burger-line"></span>
				<span class="ark-burger-line"></span>
			</button>
			<a class="brand ark-brand" href="{{ dispatcher.build_url('admin/equipe-dashboard') }}">
				<span class="ark-brand-icon">⚡</span>
				<span class="ark-brand-name">ARK <span class="ark-brand-accent">Router</span></span>
			</a>
			<div class="ark-mobile-spacer"></div>
		</div>

		<div class="ark-sidebar-backdrop" id="ark-sidebar-backdrop"></div>

		<aside class="ark-sidebar" id="ark-sidebar">
			<div class="ark-sidebar-header">
				<a class="brand ark-brand" href="{{ dispatcher.build_url('admin/equipe-dashboard') }}">
					<span class="ark-brand-icon">⚡</span>
					<span class="ark-brand-name">ARK <span class="ark-brand-accent">Router</span></span>
				</a>
				<button type="button" class="ark-sidebar-close" id="ark-sidebar-close" aria-label="Fechar">&times;</button>
			</div>
			<div class="ark-sidebar-nav">
				<ul class="nav" id="topmenu" style="display:none"></ul>
			</div>
			<div class="ark-sidebar-footer">
				<div id="indicators" class="ark-indicators"></div>
			</div>
		</aside>
		{% endif %}

		<div id="maincontent" class="container ark-main-container">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				{%
					let ark_lang = 'pt-br';
					try {
						let cursor = require('uci').cursor();
						ark_lang = cursor.get('equipe_dashboard', 'main', 'language') || 'pt-br';
					} catch(e) {}
					let is_en = (ark_lang == 'en');
				%}
				<div class="alert-message warning">
					<h4>{{ is_en ? _('No password set!') : 'Nenhuma senha definida!' }}</h4>
					<p>{{ is_en ? _('There is no password set on this router. Please configure a root password to protect the web interface.') : 'Não há nenhuma senha configurada neste roteador. Por favor, configure uma senha para o usuário root a fim de proteger o painel.' }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn cbi-button cbi-button-apply" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ is_en ? _('Go to password configuration...') : 'Configurar senha de acesso…' }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>JavaScript obrigatório!</h4>
					<p>Você precisa habilitar o JavaScript no navegador para que o painel funcione corretamente.</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
