{
	"luci-app-equipe-dashboard": {
		"description": "Painel operacional ARK Router",
		"read": {
			"file": {
				"/bin/ping": [ "exec" ],
				"/usr/sbin/equipe-dashboard-control": [ "exec" ],
				"/usr/libexec/nlbwmon-action": [ "exec" ],
				"/tmp/equipe-traffic-history.csv": [ "read" ],
				"/tmp/equipe-wan-daily.csv": [ "read" ],
				"/proc/net/arp": [ "read" ],
				"/sys/class/thermal/thermal_zone0/temp": [ "read" ]
			},
			"ubus": {
				"file": [ "exec", "read" ],
				"iwinfo": [ "assoclist", "survey", "scan", "freqlist", "countrylist" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints" ],
				"mwan3": [ "status" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"network.wireless": [ "status" ],
				"system": [ "board", "info" ],
				"uci": [ "changes", "get" ]
			},
			"uci": [ "attendedsysupgrade", "dhcp", "equipe_dashboard", "equipe_devices", "equipe_perf", "firewall", "luci", "mwan3", "network", "qos_equipe", "sqm", "starlink_telemetry", "transmission", "wireless" ]
		},
		"write": {
			"file": {
				"/usr/sbin/equipe-dashboard-control": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"uci": [ "add", "apply", "commit", "delete", "set" ]
			},
			"uci": [ "attendedsysupgrade", "dhcp", "equipe_dashboard", "equipe_devices", "equipe_perf", "firewall", "luci", "mwan3", "network", "qos_equipe", "sqm", "starlink_telemetry", "transmission", "wireless" ]
		}
	}
}
