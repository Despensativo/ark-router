#!/bin/sh
# /usr/sbin/equipe-dashboard-control - ARK Router Unified CLI & LuCI Backend Controller
# Modular architecture: Delegating to domain libraries in /usr/lib/ark/modules/
# 100% POSIX /bin/ash compliant for OpenWrt 25.12 to 19.07.

[ -n "${ARK_ROOT}" ] || ARK_ROOT=""
if [ -z "${ARK_LIB_DIR}" ]; then
	if [ -n "${ARK_ROOT}" ] && [ -d "${ARK_ROOT}/usr/lib/ark" ]; then
		ARK_LIB_DIR="${ARK_ROOT}/usr/lib/ark"
	elif [ -d "/usr/lib/ark" ]; then
		ARK_LIB_DIR="/usr/lib/ark"
	elif [ -d "$(dirname "$0")/../lib/ark" ]; then
		ARK_LIB_DIR="$(dirname "$0")/../lib/ark"
	else
		ARK_LIB_DIR="/usr/lib/ark"
	fi
fi

# Coalescencia non-blocking para hotplugs automaticos (ark-doctor --auto):
# Se ja houver auditoria ou mutacao em andamento, encerra em 0ms sem carregar 10.000+ linhas nem enfileirar.
case "${1:-}:${2:-}" in
	ark-doctor:--auto|ark-doctor:auto|audit-system:--auto|audit-system:auto)
		for _ark_lk in "${ARK_LOCK_DIR:-${ARK_ROOT}/tmp}/ark-doctor.lockdir" "${ARK_ROOT}/tmp/ark_mutation.lock"; do
			if [ -d "$_ark_lk" ] && [ -r "$_ark_lk/pid" ]; then
				read -r _ark_lpid < "$_ark_lk/pid" 2>/dev/null || _ark_lpid=''
				case "$_ark_lpid" in ''|*[!0-9]*) _ark_lpid='' ;; esac
				if [ -n "$_ark_lpid" ] && kill -0 "$_ark_lpid" 2>/dev/null; then
					exit 0
				fi
			fi
		done
		unset _ark_lk _ark_lpid
		;;
esac

# Leituras quentes: reutiliza o mesmo TTL do módulo sem carregar suas dependências.
# ARK_ROOT usa apenas o cache isolado do sandbox, nunca o /tmp do hospedeiro.
_ark_cache_ttl=120
case "${1:-}" in
	device-fingerprints) _ark_cache_name=ark-fp-cache ;;
	device-stations|wifi-stations) _ark_cache_name=ark-stations-cache ;;
	mwan-status-fast|mwan-status) _ark_cache_name=ark-mwan-cache; _ark_cache_ttl=3 ;;
	system-perf-status) _ark_cache_name=ark-perf-cache ;;
	system-hardware-info) _ark_cache_name=ark-hw-cache ;;
	doctor-status)
		if [ -s "${ARK_ROOT}/tmp/ark-doctor-last.json" ]; then
			cat "${ARK_ROOT}/tmp/ark-doctor-last.json" && exit 0
		fi
		_ark_cache_name=''
		;;
	*) _ark_cache_name='' ;;
esac
if [ -n "$_ark_cache_name" ] && [ ! -f "${ARK_ROOT}/tmp/ark_mock_stations.json" ]; then
	_ark_cache="${ARK_ROOT}/tmp/$_ark_cache_name"
	_ark_cache_time=0
	if [ -s "$_ark_cache.json" ] && [ -r "$_ark_cache.ts" ]; then
		read -r _ark_cache_time < "$_ark_cache.ts" || _ark_cache_time=0
		case "$_ark_cache_time" in ''|*[!0-9]*) _ark_cache_time=0 ;; esac
		_ark_cache_now="$(date +%s)"
		if [ "$_ark_cache_time" -gt 0 ] && [ "$_ark_cache_now" -ge "$_ark_cache_time" ] && [ $((_ark_cache_now - _ark_cache_time)) -lt "$_ark_cache_ttl" ]; then
			case "${1:-}" in
				system-perf-status)
					_ark_cc="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)"
					_ark_ma="$(awk '/MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null || awk '/MemFree:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 0)"
					sed -e "s/\"conntrack_count\":[0-9]*/\"conntrack_count\":$_ark_cc/" -e "s/\"mem_avail_kb\":[0-9]*/\"mem_avail_kb\":$_ark_ma/" "$_ark_cache.json" && exit 0
					;;
				system-hardware-info)
					_ark_stat_f="${ARK_ROOT}/tmp/ark-cpu-usage.prev"
					_ark_cstat="$(awk '/^cpu / {print $2+$3+$4+$5+$6+$7+$8, $5}' /proc/stat 2>/dev/null || echo '0 0')"
					_ark_ctot="${_ark_cstat%% *}"; _ark_cidle="${_ark_cstat#* }"; _ark_cpct=0
					if [ -f "$_ark_stat_f" ]; then
						read -r _ark_pstat < "$_ark_stat_f" 2>/dev/null || _ark_pstat='0 0'
						_ark_ptot="${_ark_pstat%% *}"; _ark_pidle="${_ark_pstat#* }"
						_ark_dtot=$((_ark_ctot - _ark_ptot)); _ark_didle=$((_ark_cidle - _ark_pidle))
						if [ "$_ark_dtot" -gt 0 ]; then
							_ark_dused=$((_ark_dtot - _ark_didle))
							[ "$_ark_dused" -lt 0 ] && _ark_dused=0
							_ark_cpct=$(( (_ark_dused * 100) / _ark_dtot ))
						fi
					fi
					printf '%s\n' "$_ark_cstat" > "$_ark_stat_f" 2>/dev/null || true
					sed -e "s/\"usage_pct\":[0-9]*/\"usage_pct\":$_ark_cpct/" "$_ark_cache.json" && exit 0
					;;
				*)
					cat "$_ark_cache.json" && exit 0
					;;
			esac
		fi
	fi
fi
unset _ark_cache_name _ark_cache _ark_cache_time _ark_cache_now _ark_cache_ttl _ark_cc _ark_ma _ark_stat_f _ark_cstat _ark_ctot _ark_cidle _ark_cpct _ark_pstat _ark_ptot _ark_pidle _ark_dtot _ark_didle _ark_dused

# Load core foundation libraries
. "${ARK_LIB_DIR}/common.sh"
. "${ARK_LIB_DIR}/logging.sh"
. "${ARK_LIB_DIR}/validation.sh"

action="$1"
[ -n "$action" ] || { echo "Uso: $0 <comando> [argumentos...]" >&2; exit 1; }

_ark_has_mut_lock=0
if [ "${ARK_MUTATION_LOCK_HELD:-0}" != "1" ] && ! ark_is_readonly_action "$action" "$2"; then
	ark_acquire_mutation_lock "$action" || exit 1
	_ark_has_mut_lock=1
	export ARK_MUTATION_LOCK_HELD=1
	trap 'ark_release_mutation_lock' EXIT INT TERM HUP
fi

case "$action" in
	audit-system|ark-doctor|doctor-*)
		. "${ARK_LIB_DIR}/modules/doctor.sh"
		if [ "$action" = "audit-system" ] || [ "$action" = "ark-doctor" ]; then
			shift
			handle_doctor "$@"
		else
			handle_doctor "$@"
		fi
		;;
	sqm-*|irqbalance-*|system-hardware-sqm-audit)
		. "${ARK_LIB_DIR}/modules/sqm.sh"
		handle_sqm "$@"
		;;
	wan-*|lan-*|mwan*|autowan-*|system-network-mode-*|pppoe-*|ping-target-*|ipv6-*|sync-ipv6-firewall|ensure_mwan3_ark_config)
		. "${ARK_LIB_DIR}/modules/network.sh"
		handle_network "$@"
		;;
	device-*|satellite-*|wifi-stations|wifi-mesh-satellite-sync-leases|setup-fingerprint-hook|setup-dhcp-fingerprint|rename|flush-stale-leases|speedtest-*|reboot-*)
		. "${ARK_LIB_DIR}/modules/devices.sh"
		handle_devices "$@"
		;;
	wifi*|channels|country)
		. "${ARK_LIB_DIR}/modules/wifi.sh"
		handle_wifi "$@"
		;;
	starlink-*)
		. "${ARK_LIB_DIR}/modules/starlink.sh"
		handle_starlink "$@"
		;;
	speedify*|rpc-disconnect-test)
		. "${ARK_LIB_DIR}/modules/speedify.sh"
		handle_speedify "$@"
		;;
	zerotier*|wireguard*)
		. "${ARK_LIB_DIR}/modules/vpn.sh"
		handle_vpn "$@"
		;;
	adblock*|sso-login|uninstall)
		. "${ARK_LIB_DIR}/modules/adblock.sh"
		handle_adblock "$@"
		;;
	system-perf*|system-processes*|ram-purge-now|dmz*|upnp-*|zram-*|dns-turbo*|network-capacity*|system-memory-purge|system-storage-purge|fast-targets|https-redirect|asu-check-*|cleanup-orphan-leds|get-led-*|set-led-*|led-*|update-led-alert|update-wan-led|system-hardware-*|hardware-tune|transmission-*|safe-storage-reboot|ntp-*|time-*|clock-*)
		. "${ARK_LIB_DIR}/modules/system.sh"
		handle_system "$@"
		;;
	ez-setup-*|features|feature-*|self-update-*|manual-update-*|cleanup-*|theme|language|title|profile|appearance|card-state-*)
		. "${ARK_LIB_DIR}/modules/ezsetup.sh"
		handle_ezsetup "$@"
		;;
	ksmbd-*|wol-*)
		. "${ARK_LIB_DIR}/modules/storage_wol.sh"
		handle_storage_wol "$@"
		;;
	*)
		[ "$_ark_has_mut_lock" = "1" ] && ark_release_mutation_lock
		echo "Comando desconhecido: $action" >&2
		exit 1
		;;
esac
_ark_rc=$?
[ "$_ark_has_mut_lock" = "1" ] && ark_release_mutation_lock
exit $_ark_rc

