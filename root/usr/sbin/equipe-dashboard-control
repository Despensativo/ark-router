try:
    with open(yaml_path, 'r', encoding='utf-8') as f:
        content = f.read()

    lines = content.splitlines()
    idx_ur = -1
    for i, l in enumerate(lines):
        if re.match(r'^user_rules:', l):
            idx_ur = i
