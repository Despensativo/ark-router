		printf '{"status":"error","message":"AdGuard Home nao encontrado no roteador","added":0,"total":0}\n'
		return 1
	fi
	if ! command -v python3 >/dev/null 2>&1; then
		printf '{"status":"error","message":"Python3 necessario para sincronizar regras","added":0,"total":0}\n'
		return 1
	fi

	python3 -c "
import re, json, sys

yaml_path = '/etc/adguardhome/adguardhome.yaml'

OFFICIAL_WHITELIST = [
