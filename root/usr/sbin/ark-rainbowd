0d00ff:13:0:255
1900ff:25:0:255
2600ff:38:0:255
3300ff:51:0:255
4000ff:64:0:255
4c00ff:76:0:255
5900ff:89:0:255
6600ff:102:0:255
7300ff:115:0:255
8000ff:128:0:255
8c00ff:140:0:255
9900ff:153:0:255
a600ff:166:0:255
b300ff:179:0:255
bf00ff:191:0:255
cc00ff:204:0:255
d900ff:217:0:255
e600ff:230:0:255
f200ff:242:0:255
ff00ff:255:0:255
ff00f2:255:0:242
ff00e6:255:0:230
ff00d9:255:0:217
ff00cc:255:0:204
ff00bf:255:0:191
ff00b3:255:0:179
ff00a6:255:0:166
ff0099:255:0:153
