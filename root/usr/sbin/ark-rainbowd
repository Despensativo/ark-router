ff001a:255:0:26
ff000d:255:0:13
"

_sleep_step() {
	[ -z "${ARK_TEST_SINGLE_PASS:-}" ] || return 0
	local spd="$1"
	local ms=40
	case "$spd" in
		fast) ms=20 ;;
		slow) ms=70 ;;
		*) ms=40 ;;
	esac

	if command -v usleep >/dev/null 2>&1; then
		usleep $((ms * 1000)) 2>/dev/null || sleep 1
	elif command -v lua >/dev/null 2>&1; then
		lua -e "local n=require('nixio'); n.nanosleep(0, ${ms}000000)" 2>/dev/null || sleep 1
	else
		sleep 1
	fi
}

# Configura nó de hardware uma única vez antes de iniciar a rotação de espectro
if [ -n "$TARGET_RGB_MULTI" ]; then
	echo default-on > "$LED_BASE/$TARGET_RGB_MULTI/trigger" 2>/dev/null || true
	echo 255 > "$LED_BASE/$TARGET_RGB_MULTI/brightness" 2>/dev/null || true
fi

while true; do
	local_enabled="$(uci -q get system.led_status.enabled || echo 1)"
	local_effect="$(uci -q get system.led_status.effect || echo rainbow)"
	if [ "$local_enabled" = "0" ] || [ "$local_effect" != "rainbow" ]; then
		break
	fi

	local_speed="$(uci -q get system.led_status.speed || echo normal)"

	for entry in $RAINBOW_STEPS; do
		hex="${entry%%:*}"
		rest="${entry#*:}"
		r="${rest%%:*}"
		rest="${rest#*:}"
		g="${rest%%:*}"
		b="${rest#*:}"

		# 1. Hardware Matrix AW21018 (Mode 1: Solid RGB direct write per channel)
		if [ -n "$TARGET_AW" ]; then
			echo "1 $hex 1" >> "$TARGET_AW" 2>/dev/null || true
			echo "0 $hex 1" >> "$TARGET_AW" 2>/dev/null || true
		fi

		# 2. Hardware WS2812B / multi_intensity (Respeita ordem definida pelo multi_index do driver)
		if [ -n "$TARGET_RGB_MULTI" ]; then
			if [ "$TARGET_RGB_ORDER" = "grb" ]; then
				echo "$g $r $b" > "$LED_BASE/$TARGET_RGB_MULTI/multi_intensity" 2>/dev/null || true
			elif [ "$TARGET_RGB_ORDER" = "bgr" ]; then
				echo "$b $g $r" > "$LED_BASE/$TARGET_RGB_MULTI/multi_intensity" 2>/dev/null || true
			else
				echo "$r $g $b" > "$LED_BASE/$TARGET_RGB_MULTI/multi_intensity" 2>/dev/null || true
			fi
		fi

		_sleep_step "$local_speed"
	done

	[ -z "${ARK_TEST_SINGLE_PASS:-}" ] || break
done

exit 0
