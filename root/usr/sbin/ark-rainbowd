33ff00:51:255:0
26ff00:38:255:0
1aff00:26:255:0
0dff00:13:255:0
00ff00:0:255:0
00ff0d:0:255:13
00ff19:0:255:25
00ff26:0:255:38
00ff33:0:255:51
00ff40:0:255:64
00ff4d:0:255:77
00ff59:0:255:89
00ff66:0:255:102
00ff73:0:255:115
00ff80:0:255:128
00ff8c:0:255:140
00ff99:0:255:153
00ffa6:0:255:166
00ffb3:0:255:179
00ffbf:0:255:191
00ffcc:0:255:204
00ffd9:0:255:217
00ffe5:0:255:229
00fff2:0:255:242
00ffff:0:255:255
00f2ff:0:242:255
00e5ff:0:229:255
00d9ff:0:217:255
00ccff:0:204:255
00bfff:0:191:255
00b2ff:0:178:255
00a6ff:0:166:255
