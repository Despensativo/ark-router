#!/bin/sh
# ARK Router — Smooth Multi-Color Spectrum (Rainbow) Daemon
# 100% POSIX /bin/ash compliant for OpenWrt 19.07 through 25.12+
# Autonomous hue rotation with zero CPU overhead (120 micro-steps, analog smoothness)

# If ucode is available (OpenWrt 23.05+), delegate to native uloop daemon (0% CPU, 0 subshell forks)
if [ -z "${ARK_TEST_FORCE_SH:-}" ] && command -v ucode >/dev/null 2>&1; then
	if [ -f "/usr/lib/ark/ark-rainbowd.uc" ]; then
		exec ucode /usr/lib/ark/ark-rainbowd.uc "$@"
	elif [ -n "${ARK_ROOT:-}" ] && [ -f "${ARK_ROOT}/usr/lib/ark/ark-rainbowd.uc" ]; then
		exec ucode "${ARK_ROOT}/usr/lib/ark/ark-rainbowd.uc" "$@"
	fi
fi

trap 'exit 0' TERM INT HUP QUIT

_get_led_sys() {
	if [ -n "${ARK_ROOT}" ] && [ -d "${ARK_ROOT}/sys/class/leds" ]; then
		printf '%s' "${ARK_ROOT}/sys/class/leds"
	else
		printf '/sys/class/leds'
	fi
}

LED_BASE="$(_get_led_sys)"

TARGET_AW=""
TARGET_RGB_MULTI=""

if [ -d "$LED_BASE/aw21018_led" ]; then
	TARGET_AW="$LED_BASE/aw21018_led/led"
fi

for p in "$LED_BASE"/*/multi_intensity; do
	if [ -e "$p" ]; then
		TARGET_RGB_MULTI="$(basename "$(dirname "$p")")"
		break
	fi
done
[ -n "$TARGET_RGB_MULTI" ] || [ ! -e "$LED_BASE/rgb:status" ] || TARGET_RGB_MULTI="rgb:status"

TARGET_RGB_ORDER="rgb"
if [ -n "$TARGET_RGB_MULTI" ] && [ -e "$LED_BASE/$TARGET_RGB_MULTI/multi_index" ]; then
	case "$(cat "$LED_BASE/$TARGET_RGB_MULTI/multi_index" 2>/dev/null)" in
		*green*red*blue*) TARGET_RGB_ORDER="grb" ;;
		*blue*green*red*) TARGET_RGB_ORDER="bgr" ;;
		*) TARGET_RGB_ORDER="rgb" ;;
	esac
fi

# Precomputed 120-step High-Definition Rainbow Look-Up Table (3° angle resolution)
# Ensures 100% analog-like continuous transition with zero visual jumps
RAINBOW_STEPS="
ff0000:255:0:0
ff0d00:255:13:0
ff1900:255:25:0
ff2600:255:38:0
ff3300:255:51:0
ff4000:255:64:0
ff4d00:255:77:0
ff5900:255:89:0
ff6600:255:102:0
ff7300:255:115:0
ff8000:255:128:0
ff8c00:255:140:0
ff9900:255:153:0
ffa600:255:166:0
ffb200:255:178:0
ffbf00:255:191:0
ffcc00:255:204:0
ffd900:255:217:0
ffe500:255:229:0
fff200:255:242:0
ffff00:255:255:0
f2ff00:242:255:0
e6ff00:230:255:0
d9ff00:217:255:0
ccff00:204:255:0
bfff00:191:255:0
b2ff00:178:255:0
a6ff00:166:255:0
99ff00:153:255:0
8cff00:140:255:0
80ff00:128:255:0
73ff00:115:255:0
66ff00:102:255:0
