#!/bin/sh
# Observacao do endpoint HTTP local. Porta 80 sem resposta nao identifica
# servidor, configuracao ou causa; nunca autoriza kill/restart ou mudanca de ACL.

if wget -q -T 3 -O /dev/null http://127.0.0.1/ >/dev/null 2>&1; then
    exit 0
fi
sleep 1
if ! wget -q -T 3 -O /dev/null http://127.0.0.1/ >/dev/null 2>&1; then
    logger -t ark-watchdog "AVISO: HTTP local na porta 80 sem resposta. Confira servidor, porta e logs; nenhuma configuracao ou servico foi alterado."
fi
exit 0
