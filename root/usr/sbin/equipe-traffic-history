#!/bin/sh

history='/tmp/equipe-traffic-history.csv'
persist='/etc/equipe-traffic-history.csv'
state='/tmp/equipe-traffic-history.state'

read_counter() {
	local device="$1" direction="$2" value
	[ -n "$device" ] || { printf 0; return 0; }
	value="$(cat "/sys/class/net/$device/statistics/${direction}_bytes" 2>/dev/null)"
	printf '%s' "${value:-0}"
}

wan_devices() {
	local w status dev seen
	seen=""
	for w in $(uci -q show network | grep '=interface' | cut -d. -f2 | cut -d= -f1 | grep -E '^wan([0-9]+)?$'); do
		[ "$(uci -q get "network.$w.proto")" != "none" ] || continue
		dev="$(uci -q get "network.$w.device")"
		[ -n "$dev" ] && [ -d "/sys/class/net/$dev" ] || {
			status="$(ifstatus "$w" 2>/dev/null)"
			dev="$(printf '%s\n' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
			[ -n "$dev" ] && [ -d "/sys/class/net/$dev" ] || dev="$(printf '%s\n' "$status" | jsonfilter -e '@.device' 2>/dev/null)"
		}
		if [ -n "$dev" ] && [ -d "/sys/class/net/$dev" ]; then
			case " $seen " in
				*" $dev "*) ;;
				*) seen="$seen $dev"; printf '%s\n' "$dev" ;;
			esac
		fi
	done
	if [ -z "$seen" ]; then
		for dev in $(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | sort -u); do
			[ -d "/sys/class/net/$dev" ] && printf '%s\n' "$dev"
		done
	fi
}

sample() {
	local now prev_time elapsed total_down total_up dev cur_rx cur_tx prev_line prev_rx prev_tx delta_rx delta_tx max_bytes lines new_state
	now="$(date +%s)"
	prev_time=0
	[ -s "$state" ] && prev_time="$(head -n 1 "$state" 2>/dev/null | cut -d',' -f1)"
	elapsed=0
	[ -n "$prev_time" ] && [ "$prev_time" -gt 0 ] 2>/dev/null && elapsed=$((now - prev_time))

	total_down=0
	total_up=0
	new_state="$now"

	for dev in $(wan_devices); do
		cur_rx="$(read_counter "$dev" rx)"
		cur_tx="$(read_counter "$dev" tx)"
		new_state="$new_state
$dev,$cur_rx,$cur_tx"

		if [ "$elapsed" -ge 30 ] && [ "$elapsed" -le 300 ]; then
			prev_line="$(grep "^$dev," "$state" 2>/dev/null)"
			if [ -n "$prev_line" ]; then
				prev_rx="$(printf '%s' "$prev_line" | cut -d',' -f2)"
				prev_tx="$(printf '%s' "$prev_line" | cut -d',' -f3)"
				if [ -n "$prev_rx" ] && [ -n "$prev_tx" ] && [ "$cur_rx" -ge "$prev_rx" ] 2>/dev/null && [ "$cur_tx" -ge "$prev_tx" ] 2>/dev/null; then
					delta_rx=$((cur_rx - prev_rx))
					delta_tx=$((cur_tx - prev_tx))
					max_bytes=$((312500000 * elapsed))
					[ "$delta_rx" -le "$max_bytes" ] || delta_rx=0
					[ "$delta_tx" -le "$max_bytes" ] || delta_tx=0
					total_down=$((total_down + (delta_rx * 8 / elapsed)))
					total_up=$((total_up + (delta_tx * 8 / elapsed)))
				fi
			fi
		fi
	done

	printf '%s\n' "$new_state" > "$state"

	if [ "$elapsed" -ge 30 ] && [ "$elapsed" -le 300 ]; then
		[ "$total_down" -le 5000000000 ] || total_down=0
		[ "$total_up" -le 5000000000 ] || total_up=0
		printf '%s,%s,%s\n' "$now" "$total_down" "$total_up" >> "$history"
		tail -n 1440 "$history" > "$history.new" && mv "$history.new" "$history"
		lines="$(wc -l < "$history")"
		[ $((lines % 60)) -eq 0 ] && cp "$history" "$persist"
	fi
}

[ -s "$history" ] || { [ -s "$persist" ] && cp "$persist" "$history" || : > "$history"; }
while true; do
	sample
	sleep 60
done
