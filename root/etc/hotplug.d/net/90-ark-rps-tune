#!/bin/sh
# /etc/hotplug.d/net/90-ark-rps-tune - Auto-assign decoupled multicore RPS & unified latency profile
[ "$ACTION" = "add" ] || [ "$ACTION" = "bind" ] || exit 0
[ -n "$INTERFACE" ] || exit 0
case "$INTERFACE" in
	lo|br-*|veth*) exit 0 ;;
esac

root_prefix="${ARK_ROOT:-}"
lib_dir="${ARK_LIB_DIR:-/usr/lib/ark}"
cpu_cores="$(grep -c '^processor' "${root_prefix}/proc/cpuinfo" 2>/dev/null || echo 1)"
[ "$cpu_cores" -gt 1 ] 2>/dev/null || exit 0

[ -f "${lib_dir}/common.sh" ] && . "${lib_dir}/common.sh"
[ -f "${lib_dir}/hw-tune.sh" ] && . "${lib_dir}/hw-tune.sh"

ark_hw_latency_profile
wifi_active=0
ark_hw_detect_wifi_active && wifi_active=1
wan_phys_list="$(ark_hw_list_wan_phys_devs)"

rps_target="$(ark_hw_compute_rps_target "$INTERFACE" "$cpu_cores" "$wifi_active" "$wan_phys_list")"
rfs_target=0

# Apply unified latency & RPS=0 across all physical/VLAN WAN interfaces
for wdev in $wan_phys_list; do
	[ -d "${root_prefix}/sys/class/net/${wdev}" ] || continue
	ark_hw_apply_iface_latency "$wdev"
	for q in "${root_prefix}/sys/class/net/${wdev}"/queues/rx-*/rps_cpus; do
		[ -w "$q" ] && echo 0 > "$q" 2>/dev/null || true
	done
	for q in "${root_prefix}/sys/class/net/${wdev}"/queues/rx-*/rps_flow_cnt; do
		[ -w "$q" ] && echo 0 > "$q" 2>/dev/null || true
	done
done

# Suppress IPv6 link-local leaks on raw physical/VLAN devices backing any PPPoE WAN
if [ -z "$root_prefix" ]; then
	for wsec in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
		case "$wsec" in wan|wan[0-9]*|wwan*) ;; *) continue ;; esac
		[ "$(uci -q get "network.${wsec}.proto" 2>/dev/null || echo '')" = "pppoe" ] || continue
		wdev="$(uci -q get "network.${wsec}.device" || uci -q get "network.${wsec}.ifname" || echo '')"
		[ -n "$wdev" ] || continue
		wparent="$(ark_hw_resolve_phys_dev "$wdev")"
		[ -w "/proc/sys/net/ipv6/conf/${wdev}/disable_ipv6" ] && echo 1 > "/proc/sys/net/ipv6/conf/${wdev}/disable_ipv6" 2>/dev/null || true
		[ -n "$wparent" ] && [ "$wparent" != "$wdev" ] && [ -w "/proc/sys/net/ipv6/conf/${wparent}/disable_ipv6" ] && echo 1 > "/proc/sys/net/ipv6/conf/${wparent}/disable_ipv6" 2>/dev/null || true
	done
fi

ark_hw_apply_iface_latency "$INTERFACE"

for q in "${root_prefix}/sys/class/net/${INTERFACE}"/queues/rx-*/rps_cpus; do
	[ -w "$q" ] && echo "$rps_target" > "$q" 2>/dev/null || true
done
for q in "${root_prefix}/sys/class/net/${INTERFACE}"/queues/rx-*/rps_flow_cnt; do
	[ -w "$q" ] && echo "$rfs_target" > "$q" 2>/dev/null || true
done

if [ -z "$root_prefix" ]; then
	case "$INTERFACE" in
		phy*|wlan*|ath*|ra*|pppoe*|ifb*)
			[ -x /etc/init.d/ark-hardware-tune ] && /etc/init.d/ark-hardware-tune reload </dev/null >/dev/null 2>&1 &
			;;
	esac
fi
