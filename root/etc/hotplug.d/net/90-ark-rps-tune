#!/bin/sh
# /etc/hotplug.d/net/90-ark-rps-tune - Auto-assign multicore RPS mask to dynamically spawned interfaces (Wi-Fi, VPNs)
[ "$ACTION" = "add" ] || [ "$ACTION" = "bind" ] || exit 0
[ -n "$INTERFACE" ] || exit 0

[ -f /usr/lib/ark/common.sh ] && . /usr/lib/ark/common.sh
cpu_cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"
[ "$cpu_cores" -gt 1 ] 2>/dev/null || exit 0

rps_mask="$(ark_calculate_rps_mask "$cpu_cores")"
if [ "$cpu_cores" -eq 4 ] && grep -qE 'mt76|mt79|ath|qca' /proc/interrupts 2>/dev/null; then
	rps_mask="8"
fi
rps_target=0
rfs_target=0

case "$INTERFACE" in
	pppoe*)
		rps_target="$rps_mask"
		;;
	lo|ifb*|br-*|phy*|wlan*|ath*|ra*|wg*|tailscale*|zt*|tun*|tap*|sit*|gre*|veth*|*)
		rps_target=0
		;;
esac

wan_phys="$(uci -q get network.wan.device || uci -q get network.wan.ifname || uci -q get network.wan1.device || echo '')"
if [ -n "$wan_phys" ]; then
	[ -w "/sys/class/net/$wan_phys/gro_flush_timeout" ] && echo 250000 > "/sys/class/net/$wan_phys/gro_flush_timeout" 2>/dev/null || true
	[ -w "/sys/class/net/$wan_phys/napi_defer_hard_irqs" ] && echo 20 > "/sys/class/net/$wan_phys/napi_defer_hard_irqs" 2>/dev/null || true
	for q in "/sys/class/net/$wan_phys"/queues/rx-*/rps_cpus; do
		[ -w "$q" ] && echo 0 > "$q" 2>/dev/null || true
	done
	for q in "/sys/class/net/$wan_phys"/queues/rx-*/rps_flow_cnt; do
		[ -w "$q" ] && echo 0 > "$q" 2>/dev/null || true
	done
fi
if [ "$INTERFACE" = "$wan_phys" ] || [ "${INTERFACE#pppoe}" != "$INTERFACE" ]; then
	[ -w "/sys/class/net/$INTERFACE/gro_flush_timeout" ] && echo 250000 > "/sys/class/net/$INTERFACE/gro_flush_timeout" 2>/dev/null || true
	[ -w "/sys/class/net/$INTERFACE/napi_defer_hard_irqs" ] && echo 20 > "/sys/class/net/$INTERFACE/napi_defer_hard_irqs" 2>/dev/null || true
fi

case "$INTERFACE" in
	ifb*)
		ethtool -K "$INTERFACE" rx-gro-list off 2>/dev/null || true
		;;
esac

for q in "/sys/class/net/$INTERFACE"/queues/rx-*/rps_cpus; do
	[ -w "$q" ] && echo "$rps_target" > "$q" 2>/dev/null || true
done
for q in "/sys/class/net/$INTERFACE"/queues/rx-*/rps_flow_cnt; do
	[ -w "$q" ] && echo "$rfs_target" > "$q" 2>/dev/null || true
done

case "$INTERFACE" in
	phy*|wlan*|ath*|ra*|pppoe*|ifb*)
		[ -x /etc/init.d/ark-hardware-tune ] && /etc/init.d/ark-hardware-tune reload </dev/null >/dev/null 2>&1 &
		;;
esac

