#!/bin/sh
# Reaplica as otimizacoes de hardware (RPS, filas, txqueuelen) 
# caso uma porta de rede fisica suba novamente apos queda de cabo (hotplug).

[ "$ACTION" = "ifup" ] || exit 0

# Ignora loopback, pppoe e interfaces virtuais/tuneis/alias IPv6 (para nao causar recalibracoes redundantes no boot)
case "${INTERFACE}:${DEVICE}" in
	loopback:*|pppoe*:*|*:pppoe*|wan6*:*|wg*:*|*:wg*|zt*:*|*:zt*|tun*:*|*:tun*|tap*:*|*:tap*) exit 0 ;;
esac

# Verifica se a sintonia esta habilitada no sistema
[ -x /etc/init.d/ark-hardware-tune ] || exit 0

# Inicia em background silencioso
/etc/init.d/ark-hardware-tune start >/dev/null 2>&1 &
exit 0
