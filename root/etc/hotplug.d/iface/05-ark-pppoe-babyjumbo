#!/bin/sh
# /etc/hotplug.d/iface/05-ark-pppoe-babyjumbo
# ARK Router — Motor Inteligente de Auto-MTU e Baby Jumbo PPPoE (RFC 4638 + Path MTU Probe)
# Disparado automaticamente pelo netifd no evento ifup para cada WAN PPPoE (Single-WAN e Multi-WAN).

[ "$ACTION" = "ifup" ] || exit 0
[ -n "$INTERFACE" ] || exit 0
[ -n "$DEVICE" ] || exit 0

# Atua em interfaces WAN (PPPoE, DHCP, IP Fixo, Starlink, QMI)
is_wan=0
case "$INTERFACE" in
	wan*|wwan*) is_wan=1 ;;
	*) case "$DEVICE" in pppoe-*) is_wan=1 ;; esac ;;
esac
[ "$is_wan" = 1 ] || exit 0

[ -f "${ARK_LIB_DIR:-/usr/lib/ark}/common.sh" ] && . "${ARK_LIB_DIR:-/usr/lib/ark}/common.sh"

command -v ark_ensure_wan_mtu_fix >/dev/null 2>&1 && ark_ensure_wan_mtu_fix

wan_dev="$(uci -q get "network.$INTERFACE.device" || uci -q get "network.$INTERFACE.ifname")"
man_mtu="$(uci -q get "equipe_dashboard.wan_profiles.${INTERFACE}_manual_mtu" 2>/dev/null || uci -q get "network.$INTERFACE.mtu" 2>/dev/null || true)"
mtu_mode="$(uci -q get "equipe_dashboard.wan_profiles.${INTERFACE}_mtu_mode" 2>/dev/null || true)"

# Invariante fisico PPPoE: a porta fisica pai (e eventual VLAN) SEMPRE precisa suportar
# phys_mtu >= l3_mtu + 8 (minimo 1500 para PPPoE 1492; 1508 para Baby Jumbo RFC 4638).
# Nunca herdar MTU 1492 residual (ex: migracao de DHCP atras de ONT para PPPoE) na interface fisica pai.
_ark_pppoe_ensure_parent_floor() {
	local l3_target="${1:-1492}"
	local need_phys=$((l3_target + 8))
	[ "$need_phys" -lt 1500 ] && need_phys=1500
	[ -n "$wan_dev" ] || return 0
	if command -v ark_ensure_phys_device_mtu >/dev/null 2>&1; then
		ark_ensure_phys_device_mtu "$wan_dev" "$need_phys" >/dev/null 2>&1 || ark_ensure_phys_device_mtu "$wan_dev" 1500 >/dev/null 2>&1 || true
	fi
}

# Se modo manual foi configurado pelo usuario (1280 a 2000 bytes) ou MTU fixo definido na interface
if [ "$mtu_mode" = "manual" ] && [ -n "$man_mtu" ] && [ "$man_mtu" -ge 1280 ] 2>/dev/null && [ "$man_mtu" -le 2000 ] 2>/dev/null; then
	case "$DEVICE" in
		pppoe-*) _ark_pppoe_ensure_parent_floor "$man_mtu" ;;
	esac
	cur_dev_mtu="$(cat "${ARK_ROOT:-}/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 0)"
	if [ "$cur_dev_mtu" != "$man_mtu" ]; then
		if [ -n "${ARK_ROOT:-}" ] && [ -w "${ARK_ROOT}/sys/class/net/$DEVICE/mtu" ]; then
			printf '%s\n' "$man_mtu" > "${ARK_ROOT}/sys/class/net/$DEVICE/mtu" 2>/dev/null || true
		else
			ip link set "$DEVICE" mtu "$man_mtu" 2>/dev/null || true
		fi
	fi
	printf '%s\n' "$man_mtu" > "${ARK_ROOT:-}/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
	command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu
	if [ -z "${ARK_ROOT:-}" ]; then
		command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ( sleep 2; ark_ipv6_prefix_hygiene ) >/dev/null 2>&1 &
	fi
	exit 0
fi

# Se houver MTU explicito configurado na interface (ex: network.wan.mtu=1492)
if [ -n "$man_mtu" ] && [ "$man_mtu" -ge 1280 ] 2>/dev/null && [ "$man_mtu" -lt 1500 ] 2>/dev/null; then
	case "$DEVICE" in
		pppoe-*) _ark_pppoe_ensure_parent_floor "$man_mtu" ;;
	esac
	cur_dev_mtu="$(cat "${ARK_ROOT:-}/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 0)"
	if [ "$cur_dev_mtu" != "$man_mtu" ]; then
		if [ -n "${ARK_ROOT:-}" ] && [ -w "${ARK_ROOT}/sys/class/net/$DEVICE/mtu" ]; then
			printf '%s\n' "$man_mtu" > "${ARK_ROOT}/sys/class/net/$DEVICE/mtu" 2>/dev/null || true
		else
			ip link set "$DEVICE" mtu "$man_mtu" 2>/dev/null || true
		fi
	fi
	printf '%s\n' "$man_mtu" > "${ARK_ROOT:-}/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
fi

# Se nao for interface PPPoE (ex: eth1 DHCP/Static), e nao ha configuracao especial,
# dispara sondagem assincrona em background para auto-detectar o MTU da rota se em modo auto
case "$DEVICE" in
	pppoe-*) ;;
	*)
		if [ "$mtu_mode" = "auto" ] || [ -z "$mtu_mode" ]; then
			(
				sleep 2
				if command -v ark_probe_path_mtu >/dev/null 2>&1; then
					probed="$(ark_probe_path_mtu "$INTERFACE")"
					if [ -n "$probed" ] && [ "$probed" -ge 1280 ] 2>/dev/null; then
						cur_d_mtu="$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 0)"
						if [ "$cur_d_mtu" != "$probed" ] && [ "$probed" -lt 1500 ]; then
							ip link set "$DEVICE" mtu "$probed" 2>/dev/null || true
						fi
					fi
				fi
				command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu
				command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ark_ipv6_prefix_hygiene
			) >/dev/null 2>&1 &
		fi
		exit 0
		;;
esac

[ -f /usr/lib/ark/common.sh ] && . /usr/lib/ark/common.sh

command -v ark_ensure_wan_mtu_fix >/dev/null 2>&1 && ark_ensure_wan_mtu_fix

dev_mtu="$(uci -q get "network.$INTERFACE.device_mtu")"
req_mtu="$(uci -q get "network.$INTERFACE.mtu")"
wan_dev="$(uci -q get "network.$INTERFACE.device" || uci -q get "network.$INTERFACE.ifname")"

# Se o usuario ou o limite do driver fixou o MTU abaixo de 1500 (ex: 1492), respeita L3 PPPoE em 1492 sem resetar o driver L2
if [ -n "$req_mtu" ] && [ "$req_mtu" -lt 1500 ] 2>/dev/null; then
	cur_ppp_mtu="$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 0)"
	[ "$cur_ppp_mtu" = "$req_mtu" ] || ip link set "$DEVICE" mtu "$req_mtu" 2>/dev/null || true
	printf '%s\n' "$req_mtu" > "/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
	command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu
	command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ( sleep 2; ark_ipv6_prefix_hygiene ) >/dev/null 2>&1 &
	exit 0
fi

if [ "$dev_mtu" != "1508" ] || [ "$req_mtu" != "1500" ]; then
	cur_ppp_mtu="$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 1492)"
	printf '%s\n' "$cur_ppp_mtu" > "/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
	command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu
	command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ( sleep 2; ark_ipv6_prefix_hygiene ) >/dev/null 2>&1 &
	exit 0
fi

# Garante que a porta fisica pai e a sub-interface VLAN 802.1Q estejam em 1508 para RFC 4638
if [ -n "$wan_dev" ] && command -v ark_ensure_phys_device_mtu >/dev/null 2>&1; then
	if ! ark_ensure_phys_device_mtu "$wan_dev" 1508; then
		if command -v ark_acquire_mutation_lock >/dev/null 2>&1; then
			ark_acquire_mutation_lock "hotplug_babyjumbo" || exit 1
		fi
		uci -q delete "network.$INTERFACE.device_mtu"
		uci -q set "network.$INTERFACE.mtu=1492"
		uci commit network 2>/dev/null || true
		command -v ark_release_mutation_lock >/dev/null 2>&1 && ark_release_mutation_lock
		printf '1492\n' > "/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
		command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu
		command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ( sleep 2; ark_ipv6_prefix_hygiene ) >/dev/null 2>&1 &
		exit 0
	fi
fi

# Sondagem inteligente assincrona (nao bloqueia o netifd):
# 1. Respeita o teto LCP negociado pelo pppd com o BRAS da operadora (nunca forca 1500 se o BRAS recusou RFC 4638 e negociou 1492).
# 2. Valida na fibra com pacotes reais (1500 -> 1492 -> 1480 -> 1460 -> 1420) e sincroniza TCP MSS (rt mtu) + IPv6 RA MTU (ra_mtu).
(
	sleep 1
	lcp_mtu="$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 1492)"
	case "$lcp_mtu" in ''|*[!0-9]*) lcp_mtu=1492 ;; esac

	probe_target=""
	for host in 1.1.1.1 8.8.8.8 9.9.9.9; do
		if ping -4 -I "$DEVICE" -s 32 -c 1 -W 1 "$host" >/dev/null 2>&1; then
			probe_target="$host"
			break
		fi
	done

	best_mtu="$lcp_mtu"
	if [ -n "$probe_target" ]; then
		found_mtu=""
		for cand in 1500 1492 1480 1460 1420; do
			# Nao testa acima do MRU/MTU que o BRAS da operadora aceitou no LCP
			[ "$cand" -le "$lcp_mtu" ] || continue
			payload=$((cand - 28))
			if ping -4 -I "$DEVICE" -s "$payload" -c 2 -W 1 "$probe_target" >/dev/null 2>&1; then
				found_mtu="$cand"
				break
			fi
		done
		[ -n "$found_mtu" ] && best_mtu="$found_mtu"
	fi

	printf '%s\n' "$best_mtu" > "/tmp/ark-mtu-probed-$INTERFACE" 2>/dev/null || true
	cur_k_mtu="$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null || echo 0)"
	if [ "$cur_k_mtu" != "$best_mtu" ]; then
		ip link set "$DEVICE" mtu "$best_mtu" 2>/dev/null || true
	fi

	if [ "$best_mtu" = "1500" ]; then
		logger -t ark-babyjumbo "Auto-MTU ($INTERFACE): Baby Jumbo RFC 4638 homologado na operadora ($DEVICE em MTU 1500 real)."
	else
		logger -t ark-babyjumbo "Auto-MTU ($INTERFACE): Operadora limitou sessao PPPoE em ${best_mtu}B (LCP=${lcp_mtu}B). MTU e TCP MSS ajustados para ${best_mtu}B sem buraco negro."
	fi

	command -v ark_sync_lan_ipv6_ra_mtu >/dev/null 2>&1 && ark_sync_lan_ipv6_ra_mtu

	# Autolimpeza completa de prefixos IPv6 /64 antigos presos na br-lan, vizinhos e rotas
	sleep 3
	command -v ark_ipv6_prefix_hygiene >/dev/null 2>&1 && ark_ipv6_prefix_hygiene
) >/dev/null 2>&1 &
exit 0
