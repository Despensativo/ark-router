#!/bin/sh

# Sanitiza todos os nomes de host no dhcp para evitar crashes do dnsmasq (RFC 1123)
changed=0
for h in $(uci -q show dhcp 2>/dev/null | grep -E '\.name=' | cut -d. -f2 | cut -d= -f1 | sort -u); do
	cur_name="$(uci -q get "dhcp.$h.name" || true)"
	[ -n "$cur_name" ] || continue
	clean_name="$(printf '%s' "$cur_name" | sed 's/[^a-zA-Z0-9_-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
	[ -n "$clean_name" ] || clean_name="ark-$h"
	if [ "$cur_name" != "$clean_name" ]; then
		uci -q set "dhcp.$h.name=$clean_name"
		changed=1
	fi
done

# Forca o dnsmasq a sempre fornecer DHCP na LAN (evita desativacao por rogue server check)
if [ "$(uci -q get dhcp.lan.force)" != "1" ]; then
	uci -q set dhcp.lan.force='1'
	changed=1
fi

# Blindagem IPv6 para compatibilidade Apple (iOS/macOS) e APs Satelites (RFC 4862 / RFC 8106):
# Apenas aplica se o servico de Router Advertisement nao estiver explicitamente desativado (ipv4_only)
if [ "$(uci -q get dhcp.lan.ra)" != "disabled" ] && [ "$(uci -q get equipe_dashboard.ipv6.mode)" != "ipv4_only" ]; then
	# Depreciacao imediata de prefixos IPv6 antigos no odhcpd (RFC 9096 - elimina IPs fantasmas em reconexoes PPPoE)
	if [ "$(uci -q get dhcp.lan.ra_prefer_old)" != "0" ]; then
		uci -q set dhcp.lan.ra_prefer_old='0'
		changed=1
	fi

	# 1. Elimina 'managed-config' (M-bit), que quebra o SLAAC em dispositivos Apple.
	# 2. Garante 'other-config' (O-bit) para entrega stateless de DNS/RDNSS.
	# 3. Garante intervalos frequentes de RA (min=20, max=60) para rapida recuperacao de clientes moveis e satelites.
	for flag in $(uci -q get dhcp.lan.ra_flags); do
		if [ "$flag" = "managed-config" ]; then
			uci -q del_list dhcp.lan.ra_flags='managed-config'
			changed=1
		fi
	done
	if ! uci -q get dhcp.lan.ra_flags | grep -q 'other-config'; then
		uci -q add_list dhcp.lan.ra_flags='other-config'
		changed=1
	fi
	if [ "$(uci -q get dhcp.lan.ra_slaac)" != "1" ]; then
		uci -q set dhcp.lan.ra_slaac='1'
		changed=1
	fi
	# Modo auto (ra_default=2): apenas anuncia como gateway padrao se houver rota IPv6 upstream na WAN (evita black hole quando a WAN nao tem IPv6)
	if [ "$(uci -q get dhcp.lan.ra_default)" != "2" ]; then
		uci -q set dhcp.lan.ra_default='2'
		changed=1
	fi
	if [ "$(uci -q get dhcp.lan.ra_mininterval)" != "20" ] || [ "$(uci -q get dhcp.lan.ra_maxinterval)" != "60" ]; then
		uci -q set dhcp.lan.ra_mininterval='20'
		uci -q set dhcp.lan.ra_maxinterval='60'
		changed=1
	fi
fi

# Sanitizacao defensiva contra sub-redes WAN injetadas indevidamente na bridge LAN
lan_ip6_entries="$(uci -q get network.lan.ip6addr || true)"
for pfx in $lan_ip6_entries; do
	case "$pfx" in
		*feca:e2a2*|*FECA:E2A2*)
			uci -q del_list network.lan.ip6addr="$pfx" 2>/dev/null || true
			if [ "$(uci -q get network.lan.ip6addr)" = "$pfx" ]; then
				uci -q delete network.lan.ip6addr 2>/dev/null || true
			fi
			uci commit network || true
			;;
	esac
done

# Otimizacao inteligente do cachesize do dnsmasq conforme a RAM do hardware
mem_kb="$(awk '/MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 131072)"
if [ "$mem_kb" -le 135000 ]; then
	target_cache=5000
else
	target_cache=10000
fi
cur_cache="$(uci -q get dhcp.@dnsmasq[0].cachesize || true)"
if [ -z "$cur_cache" ] || [ "$cur_cache" -gt 10000 ] || [ "$cur_cache" -lt 1000 ]; then
	uci -q set "dhcp.@dnsmasq[0].cachesize=$target_cache"
	changed=1
fi

# DNS Stale Cache (RFC 8767) - Resiliência e latência 0ms em consultas de cache expirado
# Suportado nativamente no dnsmasq 2.89+ (OpenWrt moderno 23.05+). Em legado (19.07/21.02), ignora silenciosamente.
if dnsmasq --help 2>&1 | grep -q "use-stale-cache"; then
	cur_extraconf="$(uci -q get dhcp.@dnsmasq[0].extraconftext || true)"
	if ! printf '%s' "$cur_extraconf" | grep -q "use-stale-cache"; then
		if [ -n "$cur_extraconf" ]; then
			uci -q set "dhcp.@dnsmasq[0].extraconftext=${cur_extraconf}
use-stale-cache=3600"
		else
			uci -q set dhcp.@dnsmasq[0].extraconftext="use-stale-cache=3600"
		fi
		changed=1
	fi
fi
[ "$changed" = 1 ] && uci commit dhcp || true

# Otimizacao de leitura de trafego no nlbwmon (padrao de 30s para evitar sobrecarga de CPU em alto conntrack)
if [ -f /etc/config/nlbwmon ]; then
	if [ "$(uci -q get nlbwmon.@nlbwmon[0].refresh_interval)" = "2s" ] || [ -z "$(uci -q get nlbwmon.@nlbwmon[0].refresh_interval)" ]; then
		uci -q set nlbwmon.@nlbwmon[0].refresh_interval='30s'
		uci commit nlbwmon
		/etc/init.d/nlbwmon restart >/dev/null 2>&1 || true
	fi
fi
# Otimizacao de isolamento de logs do AdGuard Home (evita saturacao do syslog com consultas DNS)
if [ -f /etc/init.d/adguardhome ] && ! grep -q -- '--logfile' /etc/init.d/adguardhome; then
	sed -i '/procd_append_param command --config/a \	procd_append_param command --logfile /var/lib/adguardhome/adguardhome.log' /etc/init.d/adguardhome
fi

# Circuit breaker defensivo no init do AdGuard Home (impede religamento indevido quando desativado)
if [ -f /etc/init.d/adguardhome ] && ! grep -q 'ARK Router Circuit Breaker' /etc/init.d/adguardhome; then
	awk '
		/^start_service\(\) \{/ {
			print $0
			print "\t# ARK Router Circuit Breaker: Nunca iniciar se AdGuard/Adblock estiver desativado"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" = \"0\" ] || [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" = \"0\" ]; then"
			print "\t\treturn 0"
			print "\tfi"
			next
		}
		/^boot\(\) \{/ {
			print $0
			print "\t# ARK Router Circuit Breaker"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" = \"0\" ] || [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" = \"0\" ]; then"
			print "\t\treturn 0"
			print "\tfi"
			next
		}
		{ print }
	' /etc/init.d/adguardhome > /etc/init.d/adguardhome.tmp && mv -f /etc/init.d/adguardhome.tmp /etc/init.d/adguardhome
	chmod 755 /etc/init.d/adguardhome
fi

# Sanitizacao defensiva do /etc/mwan3.user contra religamento indevido do AdGuard por hotplug
if [ -f /etc/mwan3.user ] && grep -q '/etc/init.d/adguardhome' /etc/mwan3.user && ! grep -q 'equipe_perf.settings.adblock_enabled' /etc/mwan3.user; then
	awk '
		/\/etc\/init\.d\/adguardhome restart/ {
			print "\t# Reinicia AdGuard Home APENAS se estiver explicitamente habilitado e ativo"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" != \"0\" ] && \\"
			print "\t   [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" != \"0\" ] && \\"
			print "\t   [ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome enabled >/dev/null 2>&1 && \\"
			print "\t   pgrep -f \"AdGuardHome\" >/dev/null 2>&1; then"
			print "\t\t/etc/init.d/adguardhome restart >/dev/null 2>&1 &"
			print "\tfi"
			next
		}
		{ print }
	' /etc/mwan3.user > /etc/mwan3.user.tmp && mv -f /etc/mwan3.user.tmp /etc/mwan3.user
	chmod 755 /etc/mwan3.user
fi

# Se o AdGuard Home / Adblock estiver desativado, assegurar que nenhum processo fantasma persista
if [ "$(uci -q get equipe_perf.settings.adblock_enabled)" = "0" ] || [ "$(uci -q get equipe_perf.settings.adguard_enabled)" = "0" ]; then
	killall -9 AdGuardHome adguardhome 2>/dev/null || true
	pkill -9 -f 'AdGuardHome' 2>/dev/null || true
	pkill -9 -f 'adguardhome' 2>/dev/null || true
	ubus call service delete '{"name":"adguardhome"}' >/dev/null 2>&1 || true
	[ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome disable >/dev/null 2>&1 || true
	rm -f /etc/rc.d/*adguardhome* 2>/dev/null || true
fi

if [ -f /etc/adguardhome/adguardhome.yaml ]; then
	# Reparar chaves de configuracao que possam ter sido corrompidas por sed sem ancora
	sed -i -E 's/^[[:space:]]*(upstream_dns_file|ipset_file|dnscrypt_config_file):.*/  \1: ""/' /etc/adguardhome/adguardhome.yaml
	# Isolar log apenas na declaracao propria do bloco log:
	sed -i '/^[[:space:]]*file: ""/s|file: ""|file: "/var/lib/adguardhome/adguardhome.log"|' /etc/adguardhome/adguardhome.yaml
	sed -i 's/^[[:space:]]*max_size: 100/  max_size: 1/' /etc/adguardhome/adguardhome.yaml
	sed -i 's/^[[:space:]]*max_backups: 0/  max_backups: 1/' /etc/adguardhome/adguardhome.yaml
	
	# Proteger memoria Flash (NAND/SPI) redirecionando QueryLog e Stats para o tmpfs (RAM)
	mkdir -p /tmp/adguardhome 2>/dev/null || true
	chown adguardhome:adguardhome /tmp/adguardhome 2>/dev/null || true
	# Como o macOS/Busybox sed varia, usamos awk para injetar com seguranca as paths do tmpfs
	awk '/^querylog:/{in_q=1} /^statistics:/{in_s=1} /^[^ ]/{if($1!="querylog:" && $1!="statistics:") {in_q=0; in_s=0}} in_q && /^[[:space:]]*file_path:/ {sub(/file_path:.*/, "file_path: \"/tmp/adguardhome/querylog.json\"");} in_s && /^[[:space:]]*file_path:/ {sub(/file_path:.*/, "file_path: \"/tmp/adguardhome/stats.db\"");} {print}' /etc/adguardhome/adguardhome.yaml > /tmp/adg_tmp.yaml && mv /tmp/adg_tmp.yaml /etc/adguardhome/adguardhome.yaml 2>/dev/null || true

	# Garantir permissao e ownership para o daemon rodando sob o usuario adguardhome (ujail)
	chown -R adguardhome:adguardhome /etc/adguardhome /var/lib/adguardhome 2>/dev/null || true
	chmod 644 /etc/adguardhome/adguardhome.yaml 2>/dev/null || true
fi

# Higienizacao pos-update: limpa flag residual adblock_cloud=1 quando os servidores atuais do dnsmasq nao sao de bloqueio em nuvem
if [ "$(uci -q get equipe_perf.settings.adblock_cloud || printf 0)" = "1" ]; then
	cur_dns_srv="$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null || true)"
	case " $cur_dns_srv " in
		*" 1.1.1.2 "*|*" 1.0.0.2 "*|*" 1.1.1.3 "*|*" 1.0.0.3 "*|*" 94.140.14."* |*" 94.140.15."* |*" 208.67.222.123 "*|*" 208.67.220.123 "*|*" 185.228.168."* ) ;;
		*)
			if [ -n "$cur_dns_srv" ]; then
				uci -q set equipe_perf.settings.adblock_cloud='0'
				uci -q delete equipe_perf.settings.adblock_profile 2>/dev/null || true
				uci commit equipe_perf 2>/dev/null || true
				if [ "$(uci -q get equipe_perf.settings.dns_allservers || printf 1)" = "1" ]; then
					uci -q set dhcp.@dnsmasq[0].allservers='1'
					uci commit dhcp 2>/dev/null || true
				fi
			fi
			;;
	esac
fi

# Higienizacao pos-update para arquiteturas legadas swconfig (ex: OpenWrt 19.07 / D-Link DGL-5500 ag71xx):
# 1. Repara switch_vlan 2 caso tenha sido gravada com '02 0t' em vez de '5 0t'
# 2. Remove secoes config device (eth0 / eth0.X com type=8021q) que conflitam com a VLAN implicita do switch0 no netifd
# 3. Remove device_mtu=1508 caso o driver Ethernet do kernel (ex: ag71xx hw max 1500) rejeite Baby Jumbo
[ -f /usr/lib/ark/common.sh ] && . /usr/lib/ark/common.sh

if command -v swconfig >/dev/null 2>&1 && swconfig dev switch0 show >/dev/null 2>&1; then
	net_fixed=0
	board_wan_ports="$(command -v ark_board_switch_role_ports >/dev/null 2>&1 && ark_board_switch_role_ports wan || echo '5 0t')"
	board_wan_p="$(command -v ark_board_switch_wan_port >/dev/null 2>&1 && ark_board_switch_wan_port || echo '5')"
	for vsec in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=switch_vlan$/\1/p'); do
		if [ "$(uci -q get "network.$vsec.vlan")" = "2" ] && [ "$(uci -q get network.autowan.wan_to_lan)" != "1" ]; then
			vports="$(uci -q get "network.$vsec.ports" || true)"
			case "$vports" in
				02\ *|*02\ *)
					uci -q set "network.$vsec.ports=$board_wan_ports"
					swconfig dev switch0 vlan 2 set ports "$board_wan_ports" >/dev/null 2>&1 || true
					swconfig dev switch0 port "$board_wan_p" set pvid 2 >/dev/null 2>&1 || true
					swconfig dev switch0 set apply >/dev/null 2>&1 || true
					net_fixed=1
					;;
			esac
		fi
	done
	for dsec in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=device$/\1/p'); do
		dname="$(uci -q get "network.$dsec.name" || true)"
		case "$dname" in
			eth0|eth0.*)
				uci -q delete "network.$dsec"
				net_fixed=1
				;;
		esac
	done
	if [ -n "$(uci -q get network.wan.device)" ] && [ -n "$(uci -q get network.wan.ifname)" ]; then
		uci -q delete network.wan.device
		net_fixed=1
	fi
	if [ -d /sys/class/net/eth0 ] && command -v ark_dev_supports_mtu >/dev/null 2>&1; then
		if ! ark_dev_supports_mtu eth0 1508; then
			for w in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\(wan[0-9]*\)=interface$/\1/p'); do
				if [ "$(uci -q get "network.$w.device_mtu")" = "1508" ]; then
					uci -q delete "network.$w.device_mtu"
					net_fixed=1
				fi
				if [ "$(uci -q get "network.$w.proto")" = "pppoe" ] && [ "$(uci -q get "network.$w.mtu")" = "1492" ]; then
					uci -q delete "network.$w.mtu"
					net_fixed=1
				fi
				w_if="$(uci -q get "network.$w.ifname")"
				if [ -n "$w_if" ] && [ -f "/sys/class/net/$w_if/mtu" ]; then
					[ "$(cat "/sys/class/net/$w_if/mtu" 2>/dev/null)" = "1500" ] || ip link set "$w_if" mtu 1500 2>/dev/null || true
				fi
				if [ -f "/sys/class/net/pppoe-$w/mtu" ]; then
					cat "/sys/class/net/pppoe-$w/mtu" > "/tmp/ark-mtu-probed-$w" 2>/dev/null || true
				fi
			done
		fi
	fi
	if [ "$net_fixed" = 1 ]; then
		uci commit network 2>/dev/null || true
	fi
fi

# Em sistemas OpenWrt com uclient-fetch, evita falha "Operation not permitted" (wget returned 4) no opkg quando nao ha rota default IPv6
if [ -L /usr/bin/wget ] && [ -x /bin/uclient-fetch ]; then
	rm -f /usr/bin/wget
	cat << 'WEOF' > /usr/bin/wget
#!/bin/sh
if [ -z "$(ip -6 route show default 2>/dev/null)" ]; then
	exec /bin/uclient-fetch -4 "$@"
fi
exec /bin/uclient-fetch "$@"
WEOF
	chmod 0755 /usr/bin/wget
fi

# Auto-reparo de SSIDs invertidos em roteadores dual-band onde radio0 eh 5 GHz (11a) e radio1 eh 2,4 GHz (11g)
r0_hw="$(uci -q get wireless.radio0.hwmode || uci -q get wireless.radio0.band || true)"
r1_hw="$(uci -q get wireless.radio1.hwmode || uci -q get wireless.radio1.band || true)"
case "${r0_hw}:${r1_hw}" in
	11a:11g|11a:11b|5g:2g)
		if [ "$(uci -q get wireless.default_radio0.device)" = "radio0" ] && [ "$(uci -q get wireless.default_radio1.device)" = "radio1" ]; then
			s0="$(uci -q get wireless.default_radio0.ssid || true)"
			s1="$(uci -q get wireless.default_radio1.ssid || true)"
			case "$s1" in
				*5G*|*5g*)
					case "$s0" in
						*5G*|*5g*) ;;
						*)
							if [ -n "$s0" ] && [ -n "$s1" ]; then
								uci -q set "wireless.default_radio0.ssid=$s1"
								uci -q set "wireless.default_radio1.ssid=$s0"
								uci commit wireless 2>/dev/null || true
							fi
							;;
					esac
					;;
			esac
		fi
		;;
esac

# Limpeza automatica de arquivos orfaos de MSS clamping legado e metadados AppleDouble no fw4
rm -f /etc/nftables.d/20-mss-clamping.nft /etc/nftables.d/20-mss-clamping.nft.bak /etc/nftables.d/._* 2>/dev/null || true

# Garante que regras de prioridade por dispositivo (ark_priority_*) cubram IPv4 + IPv6 (family=any) e remove duplicatas guest_forwarding
fw_sanitized=0
for p_sec in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\(ark_priority_[^.=]*\)=rule$/\1/p'); do
	if [ "$(uci -q get "firewall.$p_sec.family")" = "ipv4" ]; then
		uci -q set "firewall.$p_sec.family=any"
		fw_sanitized=1
	fi
done
if [ -n "$(uci -q get firewall.guest_wan)" ] && [ -n "$(uci -q get firewall.guest_forwarding)" ]; then
	uci -q delete firewall.guest_forwarding
	fw_sanitized=1
fi
[ "$fw_sanitized" = 1 ] && uci commit firewall 2>/dev/null || true

# Desativa debug verboso desnecessario do pppd na WAN
if [ "$(uci -q get network.wan.debug)" = "1" ]; then
	uci -q delete network.wan.debug
	uci commit network 2>/dev/null || true
fi

# Em Single-WAN, evita que NPTv6 (masq6=1) fique preso quebrando P2P WebRTC (WhatsApp) e PPE Offload
active_wans_cnt=0
for w in wan wan2 wan3 wan4; do
	w_auto="$(uci -q get "network.$w.auto" || echo '1')"
	w_dis="$(uci -q get "network.$w.disabled" || echo '0')"
	w_proto="$(uci -q get "network.$w.proto" || echo 'none')"
	w_dev="$(uci -q get "network.$w.device" || uci -q get "network.$w.ifname" || echo '')"
	if [ "$w_auto" != "0" ] && [ "$w_dis" != "1" ] && [ "$w_proto" != "none" ] && [ "$w_proto" != "dhcpv6" ] && [ -n "$w_dev" ]; then
		active_wans_cnt=$((active_wans_cnt + 1))
	fi
done
if [ "$active_wans_cnt" -lt 2 ] && [ "$(uci -q get equipe_dashboard.ipv6.mode)" = "nptv6" ]; then
	uci -q set equipe_dashboard.ipv6=ipv6
	uci -q set equipe_dashboard.ipv6.mode='dual_stack'
	uci commit equipe_dashboard 2>/dev/null || true
	for z in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
		if [ "$(uci -q get "firewall.$z.name")" = "wan" ] && [ "$(uci -q get "firewall.$z.masq6")" = "1" ]; then
			uci -q delete "firewall.$z.masq6"
			uci commit firewall 2>/dev/null || true
		fi
	done
fi

# Higieniza filas SQM/CAKE no Download (iqdisc_opts) para usar besteffort + wash quando squash_ingress=1,
# impedindo que DSCP falso de CDNs/operadora sequestre as filas prioritarias de Voz/Video no IFB
if [ -f /etc/config/sqm ]; then
	sqm_mod=0
	sqm_is_on=0
	_mem_kb="$(awk '/MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 262144)"
	if [ "$_mem_kb" -gt 327680 ] 2>/dev/null; then
		_mlim="32M"
	elif [ "$_mem_kb" -gt 196608 ] 2>/dev/null; then
		_mlim="16M"
	else
		_mlim="4M"
	fi
	for sq in $(uci -q show sqm 2>/dev/null | sed -n 's/^sqm\.\([^.=]*\)=queue$/\1/p'); do
		[ "$(uci -q get "sqm.$sq.enabled")" = "1" ] && sqm_is_on=1
		cur_iq="$(uci -q get "sqm.$sq.iqdisc_opts")"
		if [ -n "$cur_iq" ] && [ "$(uci -q get "sqm.$sq.squash_ingress" || echo 1)" = "1" ]; then
			if printf '%s' "$cur_iq" | grep -qw 'diffserv4' || ! printf '%s' "$cur_iq" | grep -qE '(^| )(rtt|regional|metro|lan|datacentre)( |$)' || ! printf '%s' "$cur_iq" | grep -q "memlimit $_mlim"; then
				cur_iq="$(printf '%s' "$cur_iq" | sed 's/\bdiffserv4\b/besteffort/g')"
				printf '%s' "$cur_iq" | grep -qE '(^| )(rtt|regional|metro|lan|datacentre)( |$)' || cur_iq="$cur_iq rtt 50ms"
				printf '%s' "$cur_iq" | grep -qw 'nat' || cur_iq="$cur_iq nat"
				printf '%s' "$cur_iq" | grep -qw 'dual-dsthost' || cur_iq="$cur_iq dual-dsthost"
				printf '%s' "$cur_iq" | grep -qw 'wash' || cur_iq="$cur_iq wash"
				printf '%s' "$cur_iq" | grep -qw 'ingress' || cur_iq="$cur_iq ingress"
				if printf '%s' "$cur_iq" | grep -q 'memlimit'; then
					cur_iq="$(printf '%s' "$cur_iq" | sed "s/memlimit [0-9]*[Mm][Bb]*/memlimit $_mlim/g")"
				else
					cur_iq="$cur_iq memlimit $_mlim"
				fi
				uci -q set "sqm.$sq.iqdisc_opts=$cur_iq"
				sqm_mod=1
			fi
		fi
		cur_eq="$(uci -q get "sqm.$sq.eqdisc_opts")"
		if [ -n "$cur_eq" ]; then
			if ! printf '%s' "$cur_eq" | grep -qw 'wash' || ! printf '%s' "$cur_eq" | grep -qE '(^| )(rtt|regional|metro|lan|datacentre)( |$)' || ! printf '%s' "$cur_eq" | grep -q "memlimit $_mlim"; then
				printf '%s' "$cur_eq" | grep -qw 'nat' || cur_eq="$cur_eq nat"
				printf '%s' "$cur_eq" | grep -qw 'dual-srchost' || cur_eq="$cur_eq dual-srchost"
				printf '%s' "$cur_eq" | grep -qw 'ack-filter' || cur_eq="$cur_eq ack-filter"
				printf '%s' "$cur_eq" | grep -qw 'wash' || cur_eq="$cur_eq wash"
				printf '%s' "$cur_eq" | grep -qE '(^| )(rtt|regional|metro|lan|datacentre)( |$)' || cur_eq="$cur_eq rtt 50ms"
				if printf '%s' "$cur_eq" | grep -q 'memlimit'; then
					cur_eq="$(printf '%s' "$cur_eq" | sed "s/memlimit [0-9]*[Mm][Bb]*/memlimit $_mlim/g")"
				else
					cur_eq="$cur_eq memlimit $_mlim"
				fi
				uci -q set "sqm.$sq.eqdisc_opts=$cur_eq"
				sqm_mod=1
			fi
		fi
	done
	if [ "$sqm_mod" = "1" ]; then
		uci commit sqm 2>/dev/null || true
		[ "$sqm_is_on" = "1" ] && [ -x /etc/init.d/sqm ] && /etc/init.d/sqm restart >/dev/null 2>&1 || true
	fi
	if [ "$sqm_is_on" = "1" ]; then
		if [ "$(uci -q get firewall.@defaults[0].flow_offloading || echo 0)" = "1" ] || \
		   [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw || echo 0)" = "1" ]; then
			uci -q set firewall.@defaults[0].flow_offloading='0'
			uci -q set firewall.@defaults[0].flow_offloading_hw='0'
			uci commit firewall 2>/dev/null || true
		fi
		command -v nft >/dev/null 2>&1 && nft delete flowtable inet fw4 ft 2>/dev/null || true
	fi
fi

rm -f /tmp/ark-*.cache /tmp/ark-*-cache.json /tmp/ark-*-cache.ts 2>/dev/null || true

exit 0
