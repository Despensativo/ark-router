#!/bin/sh

# Sanitiza todos os nomes de host no dhcp para evitar crashes do dnsmasq (RFC 1123)
changed=0
for h in $(uci -q show dhcp 2>/dev/null | grep -E '\.name=' | cut -d. -f2 | cut -d= -f1 | sort -u); do
	cur_name="$(uci -q get "dhcp.$h.name" || true)"
	[ -n "$cur_name" ] || continue
	clean_name="$(printf '%s' "$cur_name" | sed 's/[^a-zA-Z0-9_-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
	[ -n "$clean_name" ] || clean_name="ark-$h"
	if [ "$cur_name" != "$clean_name" ]; then
		uci -q set "dhcp.$h.name=$clean_name"
		changed=1
	fi
done

# Forca o dnsmasq a sempre fornecer DHCP na LAN (evita desativacao por rogue server check)
if [ "$(uci -q get dhcp.lan.force)" != "1" ]; then
	uci -q set dhcp.lan.force='1'
	changed=1
fi

# Blindagem IPv6 para compatibilidade Apple (iOS/macOS) e APs Satelites (RFC 4862 / RFC 8106):
# Apenas aplica se o servico de Router Advertisement nao estiver explicitamente desativado (ipv4_only)
if [ "$(uci -q get dhcp.lan.ra)" != "disabled" ] && [ "$(uci -q get equipe_dashboard.ipv6.mode)" != "ipv4_only" ]; then
	# Depreciacao imediata de prefixos IPv6 antigos no odhcpd (RFC 9096 - elimina IPs fantasmas em reconexoes PPPoE)
	if [ "$(uci -q get dhcp.lan.ra_prefer_old)" != "0" ]; then
		uci -q set dhcp.lan.ra_prefer_old='0'
		changed=1
	fi

	# 1. Elimina 'managed-config' (M-bit), que quebra o SLAAC em dispositivos Apple.
	# 2. Garante 'other-config' (O-bit) para entrega stateless de DNS/RDNSS.
	# 3. Garante intervalos frequentes de RA (min=20, max=60) para rapida recuperacao de clientes moveis e satelites.
	for flag in $(uci -q get dhcp.lan.ra_flags); do
		if [ "$flag" = "managed-config" ]; then
			uci -q del_list dhcp.lan.ra_flags='managed-config'
			changed=1
		fi
	done
	if ! uci -q get dhcp.lan.ra_flags | grep -q 'other-config'; then
		uci -q add_list dhcp.lan.ra_flags='other-config'
		changed=1
	fi
	if [ "$(uci -q get dhcp.lan.ra_slaac)" != "1" ]; then
		uci -q set dhcp.lan.ra_slaac='1'
		changed=1
	fi
	if [ "$(uci -q get dhcp.lan.ra_default)" != "1" ]; then
		uci -q set dhcp.lan.ra_default='1'
		changed=1
	fi
	if [ "$(uci -q get dhcp.lan.ra_mininterval)" != "20" ] || [ "$(uci -q get dhcp.lan.ra_maxinterval)" != "60" ]; then
		uci -q set dhcp.lan.ra_mininterval='20'
		uci -q set dhcp.lan.ra_maxinterval='60'
		changed=1
	fi
fi

# Sanitizacao defensiva contra sub-redes WAN injetadas indevidamente na bridge LAN
lan_ip6_entries="$(uci -q get network.lan.ip6addr || true)"
for pfx in $lan_ip6_entries; do
	case "$pfx" in
		*feca:e2a2*|*FECA:E2A2*)
			uci -q del_list network.lan.ip6addr="$pfx" 2>/dev/null || true
			if [ "$(uci -q get network.lan.ip6addr)" = "$pfx" ]; then
				uci -q delete network.lan.ip6addr 2>/dev/null || true
			fi
			uci commit network || true
			;;
	esac
done

# Otimizacao inteligente do cachesize do dnsmasq conforme a RAM do hardware
mem_kb="$(awk '/MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 131072)"
if [ "$mem_kb" -le 135000 ]; then
	target_cache=5000
else
	target_cache=10000
fi
cur_cache="$(uci -q get dhcp.@dnsmasq[0].cachesize || true)"
if [ -z "$cur_cache" ] || [ "$cur_cache" -gt 10000 ] || [ "$cur_cache" -lt 1000 ]; then
	uci -q set "dhcp.@dnsmasq[0].cachesize=$target_cache"
	changed=1
fi
[ "$changed" = 1 ] && uci commit dhcp || true

# Otimizacao de leitura de trafego no nlbwmon (padrao de 30s para evitar sobrecarga de CPU em alto conntrack)
if [ -f /etc/config/nlbwmon ]; then
	if [ "$(uci -q get nlbwmon.@nlbwmon[0].refresh_interval)" = "2s" ] || [ -z "$(uci -q get nlbwmon.@nlbwmon[0].refresh_interval)" ]; then
		uci -q set nlbwmon.@nlbwmon[0].refresh_interval='30s'
		uci commit nlbwmon
		/etc/init.d/nlbwmon restart >/dev/null 2>&1 || true
	fi
fi
# Otimizacao de isolamento de logs do AdGuard Home (evita saturacao do syslog com consultas DNS)
if [ -f /etc/init.d/adguardhome ] && ! grep -q -- '--logfile' /etc/init.d/adguardhome; then
	sed -i '/procd_append_param command --config/a \	procd_append_param command --logfile /var/lib/adguardhome/adguardhome.log' /etc/init.d/adguardhome
fi

# Circuit breaker defensivo no init do AdGuard Home (impede religamento indevido quando desativado)
if [ -f /etc/init.d/adguardhome ] && ! grep -q 'ARK Router Circuit Breaker' /etc/init.d/adguardhome; then
	awk '
		/^start_service\(\) \{/ {
			print $0
			print "\t# ARK Router Circuit Breaker: Nunca iniciar se AdGuard/Adblock estiver desativado"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" = \"0\" ] || [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" = \"0\" ]; then"
			print "\t\treturn 0"
			print "\tfi"
			next
		}
		/^boot\(\) \{/ {
			print $0
			print "\t# ARK Router Circuit Breaker"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" = \"0\" ] || [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" = \"0\" ]; then"
			print "\t\treturn 0"
			print "\tfi"
			next
		}
		{ print }
	' /etc/init.d/adguardhome > /etc/init.d/adguardhome.tmp && mv -f /etc/init.d/adguardhome.tmp /etc/init.d/adguardhome
	chmod 755 /etc/init.d/adguardhome
fi

# Sanitizacao defensiva do /etc/mwan3.user contra religamento indevido do AdGuard por hotplug
if [ -f /etc/mwan3.user ] && grep -q '/etc/init.d/adguardhome' /etc/mwan3.user && ! grep -q 'equipe_perf.settings.adblock_enabled' /etc/mwan3.user; then
	awk '
		/\/etc\/init\.d\/adguardhome restart/ {
			print "\t# Reinicia AdGuard Home APENAS se estiver explicitamente habilitado e ativo"
			print "\tif [ \"$(uci -q get equipe_perf.settings.adblock_enabled)\" != \"0\" ] && \\"
			print "\t   [ \"$(uci -q get equipe_perf.settings.adguard_enabled)\" != \"0\" ] && \\"
			print "\t   [ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome enabled >/dev/null 2>&1 && \\"
			print "\t   pgrep -f \"AdGuardHome\" >/dev/null 2>&1; then"
			print "\t\t/etc/init.d/adguardhome restart >/dev/null 2>&1 &"
			print "\tfi"
			next
		}
		{ print }
	' /etc/mwan3.user > /etc/mwan3.user.tmp && mv -f /etc/mwan3.user.tmp /etc/mwan3.user
	chmod 755 /etc/mwan3.user
fi

# Se o AdGuard Home / Adblock estiver desativado, assegurar que nenhum processo fantasma persista
if [ "$(uci -q get equipe_perf.settings.adblock_enabled)" = "0" ] || [ "$(uci -q get equipe_perf.settings.adguard_enabled)" = "0" ]; then
	killall -9 AdGuardHome adguardhome 2>/dev/null || true
	pkill -9 -f 'AdGuardHome' 2>/dev/null || true
	pkill -9 -f 'adguardhome' 2>/dev/null || true
	ubus call service delete '{"name":"adguardhome"}' >/dev/null 2>&1 || true
	[ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome disable >/dev/null 2>&1 || true
	rm -f /etc/rc.d/*adguardhome* 2>/dev/null || true
fi

if [ -f /etc/adguardhome/adguardhome.yaml ]; then
	# Reparar chaves de configuracao que possam ter sido corrompidas por sed sem ancora
	sed -i -E 's/^[[:space:]]*(upstream_dns_file|ipset_file|dnscrypt_config_file):.*/  \1: ""/' /etc/adguardhome/adguardhome.yaml
	# Isolar log apenas na declaracao propria do bloco log:
	sed -i '/^[[:space:]]*file: ""/s|file: ""|file: "/var/lib/adguardhome/adguardhome.log"|' /etc/adguardhome/adguardhome.yaml
	sed -i 's/^[[:space:]]*max_size: 100/  max_size: 1/' /etc/adguardhome/adguardhome.yaml
	sed -i 's/^[[:space:]]*max_backups: 0/  max_backups: 1/' /etc/adguardhome/adguardhome.yaml
	# Garantir permissao e ownership para o daemon rodando sob o usuario adguardhome (ujail)
	chown -R adguardhome:adguardhome /etc/adguardhome /var/lib/adguardhome 2>/dev/null || true
	chmod 644 /etc/adguardhome/adguardhome.yaml 2>/dev/null || true
fi

exit 0
