#!/bin/sh
# Configuração global de compatibilidade UPnP / CGNAT para ARK Router

if [ -f /etc/config/upnpd ]; then
	changed=0
	# Desativa STUN obrigatorio para evitar crash no boot ("Performing STUN failed. EXITING")
	# Em conexões diretas ou PPPoE, o miniupnpd detecta a WAN nativamente com estabilidade.
	[ "$(uci -q get upnpd.config.use_stun)" = "0" ] || { uci -q set upnpd.config.use_stun='0'; changed=1; }
	[ "$(uci -q get upnpd.config.enabled)" = "1" ] || { uci -q set upnpd.config.enabled='1'; changed=1; }
	[ "$(uci -q get upnpd.config.enable_upnp)" = "1" ] || { uci -q set upnpd.config.enable_upnp='1'; changed=1; }
	[ "$(uci -q get upnpd.config.enable_natpmp)" = "1" ] || { uci -q set upnpd.config.enable_natpmp='1'; changed=1; }
	if [ "$changed" = "1" ]; then
		uci commit upnpd
		[ -x /etc/init.d/miniupnpd ] && /etc/init.d/miniupnpd restart >/dev/null 2>&1 || true
	fi
fi

exit 0
