#!/bin/sh
# Configura o Wi-Fi Nativo, Ativação no Boot e Modo Inteligente para Todos os Modelos OpenWrt

[ -f /etc/config/wireless ] || exit 0

radio2=""
radio5=""
radio6=""

for dev in $(uci -q show wireless | grep -E "=wifi-device$" | cut -d. -f2 | cut -d= -f1); do
	hwmode="$(uci -q get wireless.$dev.hwmode 2>/dev/null)"
	band="$(uci -q get wireless.$dev.band 2>/dev/null)"
	htmode="$(uci -q get wireless.$dev.htmode 2>/dev/null)"
	case "$band" in
		2g|2.4g) [ -z "$radio2" ] && radio2="$dev" ;;
		5g) [ -z "$radio5" ] && radio5="$dev" ;;
		6g) [ -z "$radio6" ] && radio6="$dev" ;;
		*)
			case "$hwmode" in
				11g|11b) [ -z "$radio2" ] && radio2="$dev" ;;
				11a) [ -z "$radio5" ] && radio5="$dev" ;;
				*)
					case "$htmode" in
						EHT320|EHT160) [ -z "$radio6" ] && radio6="$dev" || radio5="$dev" ;;
						VHT*|HE160|HE80) [ -z "$radio5" ] && radio5="$dev" || radio6="$dev" ;;
						HT20|HT40) [ -z "$radio2" ] && radio2="$dev" || radio5="$dev" ;;
					esac
					;;
			esac
			;;
	esac
done

changed=0

# 1. Ativação Nativa Obrigatória Out-of-the-Box de Todos os Rádios
for dev in $(uci -q show wireless | grep -E "=wifi-device$" | cut -d. -f2 | cut -d= -f1); do
	is_dis="$(uci -q get "wireless.$dev.disabled")"
	if [ "$is_dis" = "1" ]; then
		uci -q set "wireless.$dev.disabled=0"
		changed=1
	fi
	# Define código de país seguro se não existir para evitar bloqueio regulatório nos drivers
	cur_country="$(uci -q get "wireless.$dev.country")"
	if [ -z "$cur_country" ]; then
		uci -q set "wireless.$dev.country=BR"
		changed=1
	fi
done

# 2. Ativação e Nomeação Amigável de Todas as Interfaces AP
for iface in $(uci -q show wireless | grep -E "=wifi-iface$" | cut -d. -f2 | cut -d= -f1); do
	is_if_dis="$(uci -q get "wireless.$iface.disabled")"
	if [ "$is_if_dis" = "1" ]; then
		uci -q set "wireless.$iface.disabled=0"
		changed=1
	fi
	cur_ssid="$(uci -q get "wireless.$iface.ssid")"
	if [ "$cur_ssid" = "OpenWrt" ] || [ -z "$cur_ssid" ]; then
		dev_of_iface="$(uci -q get "wireless.$iface.device")"
		if [ -n "$radio6" ] && [ "$dev_of_iface" = "$radio6" ]; then
			uci -q set "wireless.$iface.ssid=ARK Router 6G"
		elif [ -n "$radio5" ] && [ "$dev_of_iface" = "$radio5" ]; then
			uci -q set "wireless.$iface.ssid=ARK Router 5G"
		else
			uci -q set "wireless.$iface.ssid=ARK Router"
		fi
		changed=1
	fi
done

# 3. Otimizações de Canal e Estabilidade para 2.4 GHz (IoT / Smart Home)
if [ -n "$radio2" ]; then
	ch2="$(uci -q get wireless.$radio2.channel)"
	if [ "$ch2" = "auto" ] || [ -z "$ch2" ]; then
		curr_channels="$(uci -q get wireless.$radio2.channels)"
		if [ -z "$curr_channels" ]; then
			uci -q set wireless.$radio2.channel='auto'
			uci -q add_list wireless.$radio2.channels='1'
			uci -q add_list wireless.$radio2.channels='6'
			uci -q add_list wireless.$radio2.channels='11'
			changed=1
		fi
	fi
	# Proteção anti-desconexão para Casa Inteligente / Alexas / IoT (2.4 GHz)
	uci -q delete wireless.$radio2.legacy_rates
	uci -q delete wireless.$radio2.basic_rate
	for iface in $(uci -q show wireless | grep -E "\.device=['\"]?$radio2['\"]?" | cut -d. -f2); do
		mode="$(uci -q get wireless.$iface.mode || echo ap)"
		if [ "$mode" = "ap" ]; then
			uci -q set wireless.$iface.disassoc_low_ack='0'
			uci -q set wireless.$iface.dtim_period='2'
		fi
	done
	changed=1
fi

# 4. Otimizações de Canal e Salvaguarda UNII-3 para 5 GHz
if [ -n "$radio5" ]; then
	cur_ht5="$(uci -q get wireless.$radio5.htmode)"
	ch5="$(uci -q get wireless.$radio5.channel)"
	if [ "$ch5" = "auto" ] || [ -z "$ch5" ]; then
		curr_channels="$(uci -q get wireless.$radio5.channels)"
		if [ -z "$curr_channels" ]; then
			uci -q set wireless.$radio5.ieee80211h='1'
			if [ "$cur_ht5" != "HE160" ] && [ "$cur_ht5" != "VHT160" ]; then
				uci -q set wireless.$radio5.channel='auto'
				uci -q set wireless.$radio5.acs_exclude_dfs='1'
				for ch in 36 40 44 48 149 153 157 161; do
					uci -q add_list wireless.$radio5.channels="$ch"
				done
			fi
			changed=1
		fi
	fi
	# Salvaguarda UNII-3 (149-165) em 160 MHz para evitar AP-DISABLED / crash do hostapd no boot
	if [ "$ch5" != "auto" ] && [ -n "$ch5" ] && [ "$ch5" -ge 132 ] 2>/dev/null; then
		case "$cur_ht5" in
			HE160) uci -q set wireless.$radio5.htmode='HE80'; changed=1 ;;
			VHT160) uci -q set wireless.$radio5.htmode='VHT80'; changed=1 ;;
		esac
	fi
fi

# 5. Otimizações para Rádio 6 GHz (Wi-Fi 6E / Wi-Fi 7)
if [ -n "$radio6" ]; then
	ch6="$(uci -q get wireless.$radio6.channel)"
	if [ "$ch6" = "auto" ] || [ -z "$ch6" ]; then
		uci -q set wireless.$radio6.channel='auto'
		changed=1
	fi
fi

# 6. Otimizações de Aceleração Wi-Fi 6 Out-of-the-Box (se hardware suportar)
for dev in $(uci -q show wireless | grep -E "=wifi-device$" | cut -d. -f2 | cut -d= -f1); do
	cur_ht="$(uci -q get wireless.$dev.htmode || true)"
	case "$cur_ht" in
		HE*|EHT*)
			uci -q set "wireless.$dev.bss_color=auto"
			uci -q set "wireless.$dev.he_bss_color=1"
			uci -q set "wireless.$dev.he_spatial_reuse=1"
			uci -q set "wireless.$dev.twt_responder=1"
			uci -q set "wireless.$dev.he_su_beamformer=1"
			uci -q set "wireless.$dev.he_su_beamformee=1"
			uci -q set "wireless.$dev.he_mu_beamformer=1"
			uci -q set "wireless.$dev.he_ul_mumimo=1"
			uci -q set "wireless.$dev.he_ul_ofdma=1"
			uci -q set "wireless.$dev.he_puncturing=1"
			uci -q set equipe_dashboard.wifi=settings 2>/dev/null || true
			uci -q set equipe_dashboard.wifi.wifi6_accel=1
			changed=1
			;;
	esac
done

[ "$changed" = "1" ] && {
	uci commit wireless
	uci commit equipe_dashboard 2>/dev/null || true
}

# Regra de persistência MQTT para Alexa e Casa Inteligente (portas 8883/8886 no Multi-WAN)
if [ -f /etc/config/mwan3 ] && ! uci -q get mwan3.iot_alexa_mqtt >/dev/null; then
	policy="$(uci -q get mwan3.wan_then_wan2 >/dev/null && echo 'wan_then_wan2' || echo 'balanced')"
	uci -q batch <<-EOF
		set mwan3.iot_alexa_mqtt=rule
		set mwan3.iot_alexa_mqtt.family='ipv4'
		set mwan3.iot_alexa_mqtt.proto='tcp'
		set mwan3.iot_alexa_mqtt.dest_port='8883,8886'
		set mwan3.iot_alexa_mqtt.use_policy='$policy'
		set mwan3.iot_alexa_mqtt.sticky='1'
		set mwan3.iot_alexa_mqtt.timeout='3600'
		commit mwan3
EOF
fi

# Suporte a desligamento de wpa_supplicant em modo AP exclusivo para economizar RAM
if [ -f /etc/init.d/wpad ] && ! grep -q 'wireless.globals.supplicant' /etc/init.d/wpad; then
	sed -i 's/if \[ -x "\/usr\/sbin\/wpa_supplicant" \]; then/if \[ "$(\/sbin\/uci -q get wireless.globals.supplicant || echo 1)" != "0" \] \&\& \[ -x "\/usr\/sbin\/wpa_supplicant" \]; then/' /etc/init.d/wpad 2>/dev/null || true
fi

exit 0
