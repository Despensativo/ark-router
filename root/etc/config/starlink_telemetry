config starlink_telemetry 'global'
	option enabled '0'
	option always_show '0'
	option poll_interval '1'
	option sample_mode 'auto'
	option flush_interval '15'
	option max_history_hours '25'
	option purge_boot_email '1'
	option ram_dir '/tmp/starlink_telemetry'
	option flash_dir '/etc/starlink_history'
	option wan1_name 'wan'
	option wan2_name 'wan2'

config email 'email'
	option enabled '0'
	option provider 'resend'
	option resend_api_key 're_xxxxxxxxx'
	option email_from 'onboarding@resend.dev'
	option email_to 'hcsskt@gmail.com'
	option send_daily '1'
	option send_hour '23'
	option attach_csv '1'
	option smtp_server 'smtp.gmail.com'
	option smtp_port '587'
	option smtp_tls '1'
	option smtp_user ''
	option smtp_pass ''
