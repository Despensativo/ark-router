# ARK Router: High-Priority Zero-Drop DSCP Classification (fw4 / nftables)
# Prioritizes latency-sensitive packets (ICMP, DNS, TCP handshakes) into CAKE/fq_codel
# high-priority tins without dropping bulk or torrent traffic.

chain ark_dscp_prerouting {
	type filter hook prerouting priority mangle - 5; policy accept;

	# Wash untrusted incoming WAN DSCP markings to CS0 (Best Effort).
	# Upstream Linux sch_cake.c short-circuits cake_handle_diffserv(wash) when tin_mode is
	# 'besteffort', allowing ISP-marked bulk download packets (AF21/CS3/CS4) to reach Wi-Fi
	# hostapd qos_map_set and jump into WMM AC_VI (TID 4/5) ahead of latency probes.
	iifname != { "lo", "br-*", "lan*" } ip dscp != cs0 ip dscp set cs0 comment "ARK: Wash untrusted WAN IPv4 DSCP"
	iifname != { "lo", "br-*", "lan*" } ip6 dscp != cs0 ip6 dscp set cs0 comment "ARK: Wash untrusted WAN IPv6 DSCP"

	# Fast-path exit for normal WAN TCP download data packets (> 256B, ct mark bit 0x80 not set, not SYN/RST/FIN).
	# Avoids evaluating 30+ LAN classification rules at 65,000+ pps during Gigabit downloads.
	iifname != { "lo", "br-*", "lan*" } ct mark & 0x00000080 == 0 meta l4proto tcp tcp flags & (syn | rst | fin) == 0 meta length > 256 return comment "ARK: Fast-path WAN TCP download"

	# Restore verified bidirectional flow DSCP from Conntrack (ct mark lower byte: 0x80 valid bit | 6-bit DSCP).
	# Ensures incoming WAN packets (for Wi-Fi WMM / AQL & act_ctinfo) and large mid-session gaming packets
	# keep their true Voice/Gaming (CS4=0xa0), Video (AF41=0xa2), or Bulk P2P (CS1=0x88) classification.
	ct mark & 0x000000ff == 0x000000a0 ip dscp set cs4 comment "ARK: Restore Conntrack CS4 Voice/Gaming IPv4"
	ct mark & 0x000000ff == 0x000000a0 ip6 dscp set cs4 comment "ARK: Restore Conntrack CS4 Voice/Gaming IPv6"
	ct mark & 0x000000ff == 0x000000a2 ip dscp set af41 comment "ARK: Restore Conntrack AF41 Video IPv4"
	ct mark & 0x000000ff == 0x000000a2 ip6 dscp set af41 comment "ARK: Restore Conntrack AF41 Video IPv6"
	ct mark & 0x000000ff == 0x00000088 ip dscp set cs1 comment "ARK: Restore Conntrack CS1 Bulk IPv4"
	ct mark & 0x000000ff == 0x00000088 ip6 dscp set cs1 comment "ARK: Restore Conntrack CS1 Bulk IPv6"

	# ICMP & ICMPv6 Ping Echo Requests -> CS6 (Network Control / Ultra-Low Latency)
	ip protocol icmp ip dscp set cs6 comment "ARK: ICMP Echo priority"
	ip6 nexthdr ipv6-icmp ip6 dscp set cs6 comment "ARK: ICMPv6 Echo priority"

	# DNS Queries (UDP & TCP port 53, 853, 5353) -> CS6
	udp dport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: DNS IPv4 priority"
	tcp dport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: DNS TCP IPv4 priority"
	udp dport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: DNS IPv6 priority"
	tcp dport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: DNS TCP IPv6 priority"

	# NTP Time Sync & DHCPv4/v6 Control -> CS6
	udp dport { 67, 68, 123, 546, 547 } ip dscp set cs6 comment "ARK: NTP/DHCP IPv4 priority"
	udp dport { 123, 546, 547 } ip6 dscp set cs6 comment "ARK: NTP/DHCPv6 IPv6 priority"

	# TCP Connection Control (SYN, RST, FIN) & Interactive Micro-Payloads (PSH <= 256B: WebSocket Latency Probes, SSH) -> CS5 (Voice Tin)
	tcp flags & (syn | rst | fin) != 0 ip dscp set cs5 comment "ARK: TCP Control IPv4 priority"
	tcp flags & (syn | rst | fin) != 0 ip6 dscp set cs5 comment "ARK: TCP Control IPv6 priority"
	tcp flags & psh != 0 meta length <= 256 ip dscp set cs5 comment "ARK: Interactive TCP PSH micro-payload IPv4 priority"
	tcp flags & psh != 0 meta length <= 256 ip6 dscp set cs5 comment "ARK: Interactive TCP PSH micro-payload IPv6 priority"

	# Real-Time Video & Conferencing (WhatsApp / WebRTC / STUN / TURN / Teams / Zoom) -> AF41 (Video Tin)
	udp dport { 3478-3497, 5349, 8801-8810 } ip dscp set af41 comment "ARK: WebRTC/Zoom Outgoing IPv4 Video priority"
	udp sport { 3478-3497, 5349, 8801-8810 } ip dscp set af41 comment "ARK: WebRTC/Zoom Incoming IPv4 Video priority"
	udp dport { 3478-3497, 5349, 8801-8810 } ip6 dscp set af41 comment "ARK: WebRTC/Zoom Outgoing IPv6 Video priority"
	udp sport { 3478-3497, 5349, 8801-8810 } ip6 dscp set af41 comment "ARK: WebRTC/Zoom Incoming IPv6 Video priority"

	# Real-Time Voice & Discord RTC / SIP VoIP -> CS4 (CAKE diffserv4 Voice/Gaming Tin)
	udp dport { 5060, 5061, 50000-50100 } ip dscp set cs4 comment "ARK: Discord/VoIP Outgoing IPv4 Voice priority"
	udp sport { 5060, 5061, 50000-50100 } ip dscp set cs4 comment "ARK: Discord/VoIP Incoming IPv4 Voice priority"
	udp dport { 5060, 5061, 50000-50100 } ip6 dscp set cs4 comment "ARK: Discord/VoIP Outgoing IPv6 Voice priority"
	udp sport { 5060, 5061, 50000-50100 } ip6 dscp set cs4 comment "ARK: Discord/VoIP Incoming IPv6 Voice priority"

	# Competitive Gaming Ports (CS2/Steam, CoD, LoL, Valorant, Fortnite, Minecraft) -> CS4 (Voice/Gaming Tin)
	iifname { "br-*", "lan*" } udp dport { 3074, 5000-5500, 7000-7500, 9000-9100, 19132-19133, 27000-27050 } meta length <= 512 ip dscp set cs4 comment "ARK: Competitive Gaming Ports IPv4 priority"
	iifname { "br-*", "lan*" } udp dport { 3074, 5000-5500, 7000-7500, 9000-9100, 19132-19133, 27000-27050 } meta length <= 512 ip6 dscp set cs4 comment "ARK: Competitive Gaming Ports IPv6 priority"

	# P2P / BitTorrent Default Ports -> CS1 (CAKE diffserv4 Bulk / Scavenger Tin)
	tcp dport { 6881-6889, 51413 } ip dscp set cs1 comment "ARK: P2P Bulk TCP IPv4 demotion"
	udp dport { 6881-6889, 51413 } ip dscp set cs1 comment "ARK: P2P Bulk UDP IPv4 demotion"
	tcp dport { 6881-6889, 51413 } ip6 dscp set cs1 comment "ARK: P2P Bulk TCP IPv6 demotion"
	udp dport { 6881-6889, 51413 } ip6 dscp set cs1 comment "ARK: P2P Bulk UDP IPv6 demotion"

	# Behavioral Gaming Heuristic (Low-payload LAN UDP <= 256B, excluding Web/QUIC/DNS/NTP/P2P) -> CS4 (Voice/Gaming Tin)
	iifname { "br-*", "lan*" } udp dport != { 53, 67, 68, 80, 123, 443, 853, 5353, 6881-6889, 51413 } udp sport != { 53, 67, 68, 80, 123, 443, 853, 5353, 6881-6889, 51413 } meta length <= 256 ip dscp == cs0 ip dscp set cs4 comment "ARK: Low-payload Gaming UDP IPv4 heuristic"
	iifname { "br-*", "lan*" } udp dport != { 53, 80, 123, 443, 546, 547, 853, 5353, 6881-6889, 51413 } udp sport != { 53, 80, 123, 443, 546, 547, 853, 5353, 6881-6889, 51413 } meta length <= 256 ip6 dscp == cs0 ip6 dscp set cs4 comment "ARK: Low-payload Gaming UDP IPv6 heuristic"

	# Persist verified LAN flow DSCP into Conntrack mark lower byte (0x80 | DSCP, preserving 0xffffff00 for mwan3)
	iifname { "br-*", "lan*" } ip dscp == cs4 ct mark set (ct mark & 0xffffff00) | 0x000000a0 comment "ARK: Save CS4 Voice/Gaming to ct mark IPv4"
	iifname { "br-*", "lan*" } ip6 dscp == cs4 ct mark set (ct mark & 0xffffff00) | 0x000000a0 comment "ARK: Save CS4 Voice/Gaming to ct mark IPv6"
	iifname { "br-*", "lan*" } ip dscp == af41 ct mark set (ct mark & 0xffffff00) | 0x000000a2 comment "ARK: Save AF41 Video to ct mark IPv4"
	iifname { "br-*", "lan*" } ip6 dscp == af41 ct mark set (ct mark & 0xffffff00) | 0x000000a2 comment "ARK: Save AF41 Video to ct mark IPv6"
	iifname { "br-*", "lan*" } ip dscp == cs1 ct mark set (ct mark & 0xffffff00) | 0x00000088 comment "ARK: Save CS1 Bulk to ct mark IPv4"
	iifname { "br-*", "lan*" } ip6 dscp == cs1 ct mark set (ct mark & 0xffffff00) | 0x00000088 comment "ARK: Save CS1 Bulk to ct mark IPv6"
}

chain ark_dscp_output {
	type filter hook output priority mangle - 5; policy accept;

	# Router Local ICMP & ICMPv6 Replies -> CS6
	ip protocol icmp ip dscp set cs6 comment "ARK: Local ICMP Reply priority"
	ip6 nexthdr ipv6-icmp ip6 dscp set cs6 comment "ARK: Local ICMPv6 Reply priority"

	# Router Local DNS Responses & Outbound Queries -> CS6
	udp sport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: Local DNS Reply priority"
	tcp sport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: Local DNS TCP Reply priority"
	udp sport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: Local DNS IPv6 Reply priority"
	tcp sport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: Local DNS TCP IPv6 Reply priority"
	udp dport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: Local Outbound DNS IPv4 priority"
	tcp dport { 53, 853, 5353 } ip dscp set cs6 comment "ARK: Local Outbound DNS TCP IPv4 priority"
	udp dport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: Local Outbound DNS IPv6 priority"
	tcp dport { 53, 853, 5353 } ip6 dscp set cs6 comment "ARK: Local Outbound DNS TCP IPv6 priority"

	# Dual-DoH Encrypted DNS (https-dns-proxy running as nobody / UID 65534) -> CS6
	meta skuid 65534 tcp dport 443 ip dscp set cs6 comment "ARK: Dual-DoH HTTPS IPv4 priority"
	meta skuid 65534 udp dport 443 ip dscp set cs6 comment "ARK: Dual-DoH QUIC IPv4 priority"
	meta skuid 65534 tcp dport 443 ip6 dscp set cs6 comment "ARK: Dual-DoH HTTPS IPv6 priority"
	meta skuid 65534 udp dport 443 ip6 dscp set cs6 comment "ARK: Dual-DoH QUIC IPv6 priority"

	# Router Local TCP Connection Control -> CS5
	tcp flags & (syn | rst | fin) != 0 ip dscp set cs5 comment "ARK: Local TCP Control IPv4 priority"
	tcp flags & (syn | rst | fin) != 0 ip6 dscp set cs5 comment "ARK: Local TCP Control IPv6 priority"
}
