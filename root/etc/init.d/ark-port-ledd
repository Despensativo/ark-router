#!/bin/sh /etc/rc.common
# ARK Router — Smart Hardware Port LED Monitor Service
# Procd service for OpenWrt 19.07 through 25.12+

START=97
STOP=10
USE_PROCD=1

start_service() {
	[ -d "/sys/class/leds/aw21018_led" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/ark-port-ledd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	killall ark-port-ledd 2>/dev/null || true
	pkill -f "/usr/sbin/ark-port-ledd" 2>/dev/null || true
	rm -f /var/run/ark-port-ledd.pid
	if [ -d "/sys/class/leds/aw21018_led" ]; then
		local node="/sys/class/leds/aw21018_led/led"
		for t in 2 3 4 5 6 7; do
			echo "$t 0 1" > "$node" 2>/dev/null || true
		done
	fi
}

service_triggers() {
	procd_add_reload_trigger "system"
}
