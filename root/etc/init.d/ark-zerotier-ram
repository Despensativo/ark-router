#!/bin/sh /etc/rc.common

START=19
USE_PROCD=0

boot() {
	start_service
}

start() {
	start_service
}

start_service() {
	# Roteador forte: binario real em flash (nao symlink), nao precisa extrair em RAM
	if [ -x /usr/bin/zerotier-one ] && [ ! -L /usr/bin/zerotier-one ]; then
		return 0
	fi

	# Roteador fraco: extrai pacote compactado em /tmp (RAM)
	if [ -f /etc/ark-router/zerotier-pkg.tar.gz ]; then
		mkdir -p /tmp
		if [ ! -f /tmp/usr/lib/libstdc++.so.6.0.33 ] || [ ! -f /tmp/usr/bin/zerotier-one ]; then
			tar -xzf /etc/ark-router/zerotier-pkg.tar.gz -C /tmp/ 2>/dev/null
		fi
		[ -e /usr/lib/libstdc++.so.6.0.33 ] || ln -sf /tmp/usr/lib/libstdc++.so.6.0.33 /usr/lib/libstdc++.so.6.0.33
		[ -e /usr/lib/libstdc++.so.6 ] || ln -sf libstdc++.so.6.0.33 /usr/lib/libstdc++.so.6
		[ -e /usr/bin/zerotier-one ] || ln -sf /tmp/usr/bin/zerotier-one /usr/bin/zerotier-one
		chmod +x /tmp/usr/bin/zerotier-one 2>/dev/null || true
	elif [ -f /etc/ark-router/zerotier-libs.tar.gz ]; then
		mkdir -p /tmp/lib
		if [ ! -f /tmp/lib/libstdc++.so.6.0.33 ]; then
			tar -xzf /etc/ark-router/zerotier-libs.tar.gz -C /tmp/lib 2>/dev/null
		fi
		[ -e /usr/lib/libstdc++.so.6.0.33 ] || ln -sf /tmp/lib/libstdc++.so.6.0.33 /usr/lib/libstdc++.so.6.0.33
		[ -e /usr/lib/libstdc++.so.6 ] || ln -sf libstdc++.so.6.0.33 /usr/lib/libstdc++.so.6
	fi
}

stop() {
	return 0
}

case "$1" in
	start|boot) start_service 2>/dev/null || true ;;
esac
