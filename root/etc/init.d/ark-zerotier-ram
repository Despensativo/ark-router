#!/bin/sh /etc/rc.common

START=19
USE_PROCD=0

boot() {
	start_service
}

start() {
	start_service
}

start_service() {
	# Roteador forte: binario real em flash (nao symlink), nao precisa extrair em RAM
	if [ -x /usr/bin/zerotier-one ] && [ ! -L /usr/bin/zerotier-one ]; then
		return 0
	fi

	# Roteador fraco: extrai pacote compactado em /tmp (RAM) com deteccao dinamica de libstdc++.so.6.*
	local tmp_lib lib_base
	if [ -f /etc/ark-router/zerotier-pkg.tar.gz ]; then
		mkdir -p /tmp
		tmp_lib="$(find /tmp/usr/lib -maxdepth 1 -type f -name 'libstdc++.so.6.*' 2>/dev/null | head -n 1)"
		if [ -z "$tmp_lib" ] || [ ! -f /tmp/usr/bin/zerotier-one ]; then
			tar -xzf /etc/ark-router/zerotier-pkg.tar.gz -C /tmp/ 2>/dev/null
			tmp_lib="$(find /tmp/usr/lib -maxdepth 1 -type f -name 'libstdc++.so.6.*' 2>/dev/null | head -n 1)"
		fi
		if [ -n "$tmp_lib" ]; then
			lib_base="$(basename "$tmp_lib")"
			[ -e "/usr/lib/$lib_base" ] || ln -sf "$tmp_lib" "/usr/lib/$lib_base"
			[ -e /usr/lib/libstdc++.so.6 ] || ln -sf "$lib_base" /usr/lib/libstdc++.so.6
		fi
		[ -e /usr/bin/zerotier-one ] || ln -sf /tmp/usr/bin/zerotier-one /usr/bin/zerotier-one
		chmod +x /tmp/usr/bin/zerotier-one 2>/dev/null || true
	elif [ -f /etc/ark-router/zerotier-libs.tar.gz ]; then
		mkdir -p /tmp/lib
		tmp_lib="$(find /tmp/lib -maxdepth 1 -type f -name 'libstdc++.so.6.*' 2>/dev/null | head -n 1)"
		if [ -z "$tmp_lib" ]; then
			tar -xzf /etc/ark-router/zerotier-libs.tar.gz -C /tmp/lib 2>/dev/null
			tmp_lib="$(find /tmp/lib -maxdepth 1 -type f -name 'libstdc++.so.6.*' 2>/dev/null | head -n 1)"
		fi
		if [ -n "$tmp_lib" ]; then
			lib_base="$(basename "$tmp_lib")"
			[ -e "/usr/lib/$lib_base" ] || ln -sf "$tmp_lib" "/usr/lib/$lib_base"
			[ -e /usr/lib/libstdc++.so.6 ] || ln -sf "$lib_base" /usr/lib/libstdc++.so.6
		fi
	fi
}

stop() {
	return 0
}
