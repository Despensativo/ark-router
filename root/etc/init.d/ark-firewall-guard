#!/bin/sh /etc/rc.common

START=22
USE_PROCD=1

boot() {
	# Observacao no boot: nao inferir que ausencia de tabela/processo autoriza
	# remover regras de terceiros, matar processos ou reiniciar a rede.
	. "${ARK_LIB_DIR:-/usr/lib/ark}/common.sh"
	if is_fw4; then
		if ! nft list table inet fw4 >/dev/null 2>&1; then
			logger -t ark-guard "AVISO: tabela inet fw4 ausente; confira fw4 check e logs. Regras e servicos preservados."
		fi
	elif is_fw3; then
		# O diagnostico detalhado legado permanece no Doctor sob demanda.
		:
	fi

	# Otimização universal de NAT Endpoint-Independent (Full-Cone):
	# fw4 (nftables persistent) / fw3 (iptables fullcone)
	ark_optimize_nat_endpoint_independent >/dev/null 2>&1 || true

	adblock_en="$(uci -q get equipe_perf.settings.adblock_enabled || echo 0)"
	adguard_en="$(uci -q get equipe_perf.settings.adguard_enabled || echo 0)"
	if [ "$adblock_en" = "0" ] || [ "$adguard_en" = "0" ]; then
		if pgrep -f 'AdGuardHome' >/dev/null 2>&1; then
			logger -t ark-guard "AVISO: AdGuard Home ativo com preferencia ARK desligada; confirme propriedade antes de encerrar."
		fi
	elif ! pgrep -f 'AdGuardHome' >/dev/null 2>&1; then
		logger -t ark-guard "AVISO: AdGuard Home solicitado, processo nao observado; confira procd e DNS."
	fi
	if [ -x "${ARK_ROOT}/etc/init.d/dnsmasq" ] && "${ARK_ROOT}/etc/init.d/dnsmasq" enabled >/dev/null 2>&1; then
		if ! pgrep -f 'dnsmasq' >/dev/null 2>&1; then
			logger -t ark-guard "AVISO: dnsmasq habilitado, processo nao observado; confira procd e logs."
		fi
	fi

	# 4. Verificacao de persistencia do tema (reboot / update)
	customized="$(uci -q get equipe_dashboard.main.theme_customized 2>/dev/null || uci -q get luci.main.theme_customized 2>/dev/null || echo 0)"
	user_theme="$(uci -q get equipe_dashboard.main.user_theme 2>/dev/null || uci -q get luci.main.user_theme 2>/dev/null || echo '')"
	current_theme="$(uci -q get luci.main.mediaurlbase | sed 's|/luci-static/||')"
	if [ "$customized" = "1" ] && [ -n "$user_theme" ]; then
		if [ -d "/www/luci-static/$user_theme" ] && [ "$current_theme" != "$user_theme" ]; then
			logger -t ark-theme "Restaurando tema personalizado pelo usuario: $user_theme"
			uci -q set luci.main.mediaurlbase="/luci-static/$user_theme"
			uci commit luci
		fi
	elif [ "$customized" != "1" ] && [ -d /www/luci-static/ark ] && [ "$current_theme" != "ark" ]; then
		logger -t ark-theme "Garantindo tema ARK nativo como padrao"
		uci -q set luci.main.mediaurlbase='/luci-static/ark'
		uci -q set luci.themes.ARK='/luci-static/ark'
		uci -q set equipe_dashboard.main.theme_customized='0'
		uci -q set equipe_dashboard.main.user_theme='ark'
		uci -q set luci.main.theme_customized='0'
		uci -q set luci.main.user_theme='ark'
		uci commit luci
		uci commit equipe_dashboard 2>/dev/null || true
	fi
}

start_service() {
	boot
}
