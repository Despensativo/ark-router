#!/bin/sh /etc/rc.common
# ARK Router - Serviço Procd de Telemetria Dual Starlink & Buffer 25h

USE_PROCD=1
START=96
STOP=04

CONF="starlink_telemetry"

start_service() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled global enabled 0

	[ "$enabled" -eq 1 ] || {
		logger -t "starlink-telemetry" "Serviço desativado por configuração (starlink_telemetry.global.enabled=0)."
		return 0
	}

	procd_open_instance "starlink_telemetry"
	procd_set_param command /usr/sbin/starlink-telemetry-daemon run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t "starlink-telemetry" "Instância de telemetria registrada no procd com sucesso."
}

stop_service() {
	logger -t "starlink-telemetry" "Parando serviço de telemetria e sincronizando buffer para flash..."
	if [ -x /usr/sbin/starlink-telemetry-daemon ]; then
		/usr/sbin/starlink-telemetry-daemon flush 2>/dev/null || true
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

reload_service() {
	stop
	start
}
