#!/bin/sh /etc/rc.common
# /etc/init.d/alldebrid-sync — Daemon de Sincronização AllDebrid para ARK Router

START=98
STOP=10
USE_PROCD=1
PROG="/usr/sbin/alldebrid-sync"

start_service() {
	local enabled
	config_load alldebrid
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	local apikey
	config_get apikey config apikey ""
	[ -n "$apikey" ] || return 0

	local poll
	config_get poll config poll_interval 60

	procd_open_instance "alldebrid-sync"
	procd_set_param command /bin/sh -c "while true; do $PROG; sleep $poll; done"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger alldebrid
}
